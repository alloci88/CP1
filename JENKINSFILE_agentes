/*
 * ==========================================================
 * CP1.2 JENKINSFILE_agentes (Windows) - 3 agents + parallel
 * ==========================================================
 *
 * Objetivo (segun enunciado):
 * - Ejecutar pipeline en Windows repartiendo carga en 3 agentes.
 * - Paralelizar donde tenga sentido (sin romper dependencias).
 * - Unit/Rest SIEMPRE verdes (aunque fallen) por requisito del enunciado.
 * - Coverage NO re-ejecuta unit tests: se lee desde coverage.json ya generado.
 * - Flake8 & Bandit se publican en Warnings-NG (solo graficas/historico),
 *   pero los quality gates son deterministas y se aplican por conteo.
 * - Log de identidad del agente (whoami/hostname/workspace) en cada etapa.
 *
 * Nota Windows:
 * - ASCII only para evitar problemas de encoding en Jenkins/Windows.
 * - Uso de venv via PYTHON_BIN para que el pipeline no dependa del PATH del servicio (SYSTEM).
 *
 * Nota Reto 2 (executors=1):
 * - Para que se vea el efecto de bajar executors a 1, Static y Security se ejecutan
 *   EN PARALELO pero CADA una reserva su propio executor via node(label).
 * - Si el/los nodos con label static-sec tienen executors=1, una rama quedara en cola
 *   ("waiting for next available executor") y se vera en el log.
 */

/* =========================
 * Helper functions
 * ========================= */

/*
 * Wrapper simple para bat() con etiqueta.
 * Centraliza la llamada y mantiene consistencia en logs.
 */
def runBat(String label, String script) {
    bat(label: label, script: script)
}

/*
 * Debug de ejecucion: imprime usuario, maquina y workspace real del agente.
 * Clave cuando hay multi-agente y workspaces distintos por nodo.
 */
def logAgentInfo(String stageName) {
    runBat("Agent info (${stageName})", """
        @echo off
        echo === Agent info: ${stageName} ===
        whoami
        hostname
        echo %WORKSPACE%
        exit /b 0
    """.stripIndent())
}

/*
 * Crea la estructura de carpetas de reportes.
 * Siempre se llama tras unstash, porque deleteDir() borra el workspace.
 */
def ensureReportsDirs() {
    runBat('Ensure reports dirs', """
        @echo off
        if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%"
        if not exist "%REPORTS_UNIT_DIR%" mkdir "%REPORTS_UNIT_DIR%"
        if not exist "%REPORTS_REST_DIR%" mkdir "%REPORTS_REST_DIR%"
        if not exist "%REPORTS_STATIC_DIR%" mkdir "%REPORTS_STATIC_DIR%"
        if not exist "%REPORTS_SECURITY_DIR%" mkdir "%REPORTS_SECURITY_DIR%"
        if not exist "%REPORTS_COVERAGE_DIR%" mkdir "%REPORTS_COVERAGE_DIR%"
        if not exist "%REPORTS_PERFORMANCE_DIR%" mkdir "%REPORTS_PERFORMANCE_DIR%"
        exit /b 0
    """.stripIndent())
}

/*
 * Informacion adicional del entorno.
 * Sirve para justificar que el Python usado es el esperado (venv o instalacion fija).
 */
def prepWorkspaceVerbose() {
    runBat('Workspace info (verbose)', """
        @echo off
        echo === Workspace info ===
        whoami
        hostname
        echo %WORKSPACE%
        echo === Python ===
        "%PYTHON_BIN%" --version
        exit /b 0
    """.stripIndent())
}

/*
 * Validacion previa: Wiremock debe existir en la ruta configurada.
 * Falla rapido (fail-fast) si el binario no esta disponible en el agente.
 */
def checkWiremockJar() {
    runBat('Check Wiremock jar', """
        @echo off
        if exist "%WIREMOCK_JAR%" (echo Wiremock OK) else (echo Wiremock MISSING & exit /b 1)
        exit /b 0
    """.stripIndent())
}

/*
 * Validacion previa: JMeter debe existir en la ruta configurada.
 * Falla rapido si el jar no esta en el agente asignado a performance.
 */
def checkJmeterJar() {
    runBat('Check JMeter', """
        @echo off
        if exist "%JMETER_JAR%" (echo JMeter OK) else (echo JMeter MISSING & exit /b 1)
        exit /b 0
    """.stripIndent())
}

/*
 * Limpieza defensiva de puertos (Windows).
 * Evita colisiones cuando quedan procesos previos (Flask/Wiremock) escuchando.
 * No falla si no hay procesos (exit 0).
 */
def killByPort(String port) {
    runBat("Stop processes on ${port}", """
        @echo off
        for /f "tokens=5" %%p in ('netstat -ano ^| findstr /R /C:":${port} .*LISTENING"') do (
            taskkill /F /PID %%p 1>nul 2>nul
        )
        exit /b 0
    """.stripIndent())
}

/*
 * Healthcheck simple: espera HTTP 200 contra una URL.
 * - maxTries controla el numero de intentos
 * - timeoutSec el timeout de Invoke-WebRequest
 * Falla con exit 1 si no consigue 200, para evitar tests contra servicios caidos.
 */
def waitHttp200(String url, int maxTries, int timeoutSec, String label) {
    runBat(label,
        '''
        @echo off
        for /L %%i in (1,1,%MAX_TRIES%) do (
            powershell -NoProfile -Command "try { (Invoke-WebRequest -UseBasicParsing '%URL%' -TimeoutSec %TIMEOUT%).StatusCode } catch { 0 }" ^
                | findstr "^200$" >nul && exit /b 0
            ping -n 2 127.0.0.1 >nul
        )
        exit /b 1
        '''
        .replace('%URL%', url)
        .replace('%MAX_TRIES%', maxTries.toString())
        .replace('%TIMEOUT%', timeoutSec.toString())
        .stripIndent()
    )
}

/*
 * Arranca Flask en background (start /B) en el puerto configurado.
 * --no-reload evita que el autoreloader cree procesos extra (muy importante en CI).
 */
def startFlask() {
    runBat('Start Flask', """
        @echo off
        set PYTHONPATH=.
        set FLASK_APP=app\\api.py
        start "" /B "%PYTHON_BIN%" -m flask run --host 127.0.0.1 --port %FLASK_PORT% --no-reload
        exit /b 0
    """.stripIndent())
}

/*
 * Arranca Wiremock con root-dir de stubs/mappings en test\\wiremock.
 * Se ejecuta en background para que los tests rest puedan correr en el mismo stage.
 */
def startWiremock() {
    runBat('Start Wiremock', """
        @echo off
        start "" /B java -jar "%WIREMOCK_JAR%" --port %WIREMOCK_PORT% --root-dir test\\wiremock
        exit /b 0
    """.stripIndent())
}

/*
 * Flake8 formateado como "pylint" para que Warnings-NG lo parsee con parser Pylint.
 * --exit-zero garantiza que Flake8 no rompa el stage por codigo de salida:
 * los gates los aplicamos nosotros por conteo (determinista).
 */
def runFlake8Pylint() {
    runBat('Flake8', """
        @echo off
        set PYTHONPATH=.

        rem 1) Report for Warnings-NG (Pylint parser expects this)
        "%PYTHON_BIN%" -m flake8 app\\api.py app\\calc.py ^
            --exit-zero ^
            --format=pylint ^
            > "%FLAKE8_REPORT%"

        rem 2) Report for deterministic gate counting (parser-independent)
        "%PYTHON_BIN%" -m flake8 app\\api.py app\\calc.py ^
            --exit-zero ^
            --format="%(path)s:%(row)d:%(col)d: %(code)s %(text)s" ^
            > "%FLAKE8_GATE_REPORT%"

        exit /b 0
    """.stripIndent())
}

/*
 * Bandit in pylint-like format:
 * - Importante: {test_id}/{msg} son placeholders de Bandit (NO ${...} de Groovy).
 * - Se genera:
 *   - bandit.out (custom) "pylint-like" para Warnings-NG
 *   - bandit.json para contar findings de forma robusta/determinista
 * --exit-zero evita que Bandit falle por exit code: el gate se aplica por conteo.
 */
def runBanditPylintStyle() {
    runBat('Bandit', """
        @echo off
        set PYTHONPATH=.

        rem Scan app + test folders (same scope as shown in class)
        "%PYTHON_BIN%" -m bandit --exit-zero -r app test -f custom -o "%BANDIT_OUT%" --msg-template "{abspath}:{line}: [{test_id}] {msg}"
        "%PYTHON_BIN%" -m bandit --exit-zero -r app test -f json   -o "%BANDIT_JSON%"

        exit /b 0
    """.stripIndent())
}

/*
 * Ejecuta JMeter en modo non-GUI y produce un .jtl para perfReport.
 * Aqui SI respetamos el exit code, porque el stage Performance usa catchError para
 * marcar solo el stage como FAILURE sin abortar el pipeline completo.
 */
def runJmeter() {
    runBat('JMeter', """
        @echo off
        if exist "%JMETER_JTL%" del /q "%JMETER_JTL%" 1>nul 2>nul
        java -jar "%JMETER_JAR%" -n -t "%JMETER_TESTPLAN%" -l "%JMETER_JTL%"
        exit /b %ERRORLEVEL%
    """.stripIndent())
}

/*
 * Build result escalator (SUCCESS < UNSTABLE < FAILURE)
 * Garantiza que el resultado global del build solo empeora, nunca mejora.
 * Esto es clave porque:
 * - Algunas stages deben "quedarse verdes" por requisito.
 * - Pero aun asi queremos que el resultado final refleje lo peor ocurrido.
 */
def setBuildResultWorst(String target) {
    String current = (currentBuild.result ?: 'SUCCESS')
    Map<String, Integer> rank = ['SUCCESS': 0, 'UNSTABLE': 1, 'FAILURE': 2]
    int curRank = rank.containsKey(current) ? rank[current] : 0
    int tgtRank = rank.containsKey(target) ? rank[target] : 0

    if (tgtRank > curRank) {
        currentBuild.result = target
        echo "Build result escalated: ${current} -> ${target}"
    } else {
        echo "Build result unchanged: ${current} (requested ${target})"
    }
}

/*
 * Deterministic gates (match enunciado)
 * Los findings se cuentan y se aplican umbrales:
 * - findings >= failureFrom  => stage FAILURE + build FAILURE
 * - findings >= unstableFrom => stage UNSTABLE + build UNSTABLE
 * - si no, OK
 */
def countPylintLikeFindings(String reportPath) {
    String out = bat(
        label: "Count findings in ${reportPath}",
        returnStdout: true,
        script: """
            @echo off
            if not exist "${reportPath}" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "p=r'''${reportPath}'''; f=open(p,'r',encoding='utf-8',errors='ignore'); print(sum(1 for line in f if line.strip()))"
            exit /b 0
        """.stripIndent()
    ).trim()

    return out ? out.toInteger() : 0
}

def countBanditFindingsFromJson(String banditJsonPath) {
    String out = bat(
        label: "Count bandit findings in ${banditJsonPath}",
        returnStdout: true,
        script: """
            @echo off
            if not exist "${banditJsonPath}" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; p=r'''${banditJsonPath}'''; d=json.load(open(p,'r',encoding='utf-8',errors='ignore')); print(len(d.get('results', [])))"
            exit /b 0
        """.stripIndent()
    ).trim()

    return out ? out.toInteger() : 0
}

/*
 * Aplica el gate de conteo:
 * - catchError con buildResult SUCCESS evita abortar el pipeline.
 * - stageResult marca la etapa en rojo/amarillo en Jenkins UI.
 * - setBuildResultWorst asegura el resultado global del build.
 */
def applyCountQualityGate(String stageLabel, int findings, int unstableFrom, int failureFrom) {
    echo "${stageLabel} findings = ${findings} (unstable>=${unstableFrom}, failure>=${failureFrom})"

    if (findings >= failureFrom) {
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            error("${stageLabel} unhealthy: ${findings} findings (>=${failureFrom})")
        }
        setBuildResultWorst('FAILURE')
        return
    }

    if (findings >= unstableFrom) {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
            error("${stageLabel} unstable: ${findings} findings (>=${unstableFrom})")
        }
        setBuildResultWorst('UNSTABLE')
        return
    }

    echo "${stageLabel} OK"
}

/*
 * Lectura de los datos de Coverage.
 * Lee percent de lineas y ramas desde coverage.json generado en Unit stage.
 * Esto permite una stage Coverage separada y determinista sin re-ejecutar pytest.
 */
def readCoveragePercents() {
    String outLines = bat(
        label: 'Read coverage percent (lines)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import os,json; p=os.environ.get('COVERAGE_JSON'); d=json.load(open(p)); t=d.get('totals',{}); print(f\\\"{t.get('percent_covered',0):.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    String outBranches = bat(
        label: 'Read coverage percent (branches)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import os,json; p=os.environ.get('COVERAGE_JSON'); d=json.load(open(p)); t=d.get('totals',{}); cb=t.get('covered_branches',0); nb=t.get('num_branches',0); pct=(cb*100.0/nb) if nb else 0.0; print(f\\\"{pct:.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    double linesPct = outLines ? outLines.toDouble() : 0.0
    double branchesPct = outBranches ? outBranches.toDouble() : 0.0
    return [linesPct, branchesPct]
}

/* =========================
 * Pipeline
 * ========================= */

pipeline {
    /*
     * agent none:
     * - No reservamos un nodo global para todo el pipeline.
     * - Cada stage/branch pide su propio agente con label.
     * - Reduce bloqueo de ejecutores y habilita paralelismo real.
     */
    agent none

    options {
        timestamps()

        /*
         * Evita el "Declarative: Checkout SCM" automatico.
         * Hacemos checkout una sola vez en Get Code y compartimos con stash/unstash.
         */
        skipDefaultCheckout(true)
    }

    environment {
        // AGENT LABELS
        /*
         * Labels de nodos/agents en Jenkins.
         * Deben existir en la configuracion (Manage Jenkins -> Nodes -> Labels).
         */
        PRIMARY_AGENT_LABEL = 'primary'
        STATIC_SECURITY_AGENT_LABEL = 'static-sec'
        QA_PERF_AGENT_LABEL = 'qa-perf'

        /*
         * Python fijo (idealmente venv) para reproducibilidad.
         * Evita depender del PATH del servicio Jenkins (SYSTEM) en Windows.
         */
        PYTHON_BIN = 'C:\\ci\\venvs\\cp1\\Scripts\\python.exe'

        // Directorios de salida para estandarizar artefactos y publicaciones.
        REPORTS_DIR = 'reports'
        REPORTS_UNIT_DIR = 'reports\\unit'
        REPORTS_REST_DIR = 'reports\\rest'
        REPORTS_STATIC_DIR = 'reports\\static'
        REPORTS_SECURITY_DIR = 'reports\\security'
        REPORTS_COVERAGE_DIR = 'reports\\coverage'
        REPORTS_PERFORMANCE_DIR = 'reports\\performance'

        // JUnit xml para plugins de tests.
        UNIT_JUNIT = 'reports\\unit\\result-unit.xml'
        REST_JUNIT = 'reports\\rest\\result-rest.xml'

        // Coverage:
        // - XML se usa para recordCoverage (Cobertura)
        // - JSON se usa para leer porcentajes y aplicar gate propio
        COVERAGE_XML = 'reports\\coverage\\coverage.xml'
        COVERAGE_JSON = 'reports\\coverage\\coverage.json'

        // Flake8 en formato pylint-like
        FLAKE8_REPORT = 'reports\\static\\flake8.out'
		FLAKE8_GATE_REPORT = 'reports\\static\\flake8.gate.out'

        // Bandit: salida parseable + JSON para conteo
        BANDIT_OUT = 'reports\\security\\bandit.out'
        BANDIT_JSON = 'reports\\security\\bandit.json'

        // Servicios locales para tests REST y performance
        FLASK_PORT = '5000'
        WIREMOCK_PORT = '9090'

        // Herramientas externas (ruta fija en el agente)
        WIREMOCK_JAR = 'C:\\ci\\tools\\wiremock-standalone-3.13.2.jar'

        JMETER_JAR = 'C:\\ci\\tools\\apache-jmeter-5.6.3\\bin\\ApacheJMeter.jar'
        JMETER_TESTPLAN = 'test\\jmeter\\flask.jmx'
        JMETER_JTL = 'reports\\performance\\jmeter.jtl'

        // Repo origen (sin credenciales por ser publico en esta practica)
        REPO_URL = 'https://github.com/alloci88/CP1.git'
    }

    stages {

       stage('Get Code') {
			steps {
				/*
				* Checkout controlado + stash del codigo:
				* - Usamos "checkout scm" para respetar la rama configurada en el job.
				* - stash/unstash se usa incluso en agente unico para mantener compatibilidad con JENKINSFILE_agentes.
				* - Excluimos reports/coverage/__pycache__ para no arrastrar artefactos de builds previos.
				*/
				logAgentInfo('Get Code')
		
				checkout scm
		
				prepWorkspaceVerbose()
				ensureReportsDirs()
		
				stash name: 'SRC',
					includes: '**/*',
					excludes: '.git/**,reports/**,coverage/**,**/__pycache__/**',
					useDefaultExcludes: false
			}
		}


        stage('Parallel QA') {
            /*
             * Paralelizacion:
             * - Unit (primary) genera coverage.* y REPORTS.
             * - Static+Security (static-sec) corre flake8/bandit (en paralelo scripted).
             * - Rest+Performance (qa-perf) levanta servicios y corre pruebas.
             *
             * IMPORTANTE:
             * - No dependemos de resultados entre branches salvo Coverage final,
             *   que consume el stash 'REPORTS' generado por Unit.
             */
            parallel {

                stage('Unit') {
                    agent { label "${PRIMARY_AGENT_LABEL}" }
                    steps {
                        logAgentInfo('Unit')
                        script {
                            /*
                             * deleteDir() asegura workspace limpio en el agente.
                             * En multi-agente, cada nodo mantiene su propio workspace/cache.
                             */
                            deleteDir()
                            unstash 'SRC'
                            ensureReportsDirs()

                            /*
                             * Ejecuta unit tests con coverage branch.
                             * Guardamos el exit code, pero NO fallamos el stage (requisito).
                             */
                            int rc = bat(returnStatus: true, label: 'Pytest Unit + Coverage', script: """
                                @echo off
                                call "${PYTHON_BIN}" -m coverage run --branch -m pytest --junitxml=${UNIT_JUNIT} test\\unit
                                set EXITCODE=%ERRORLEVEL%
                                call "${PYTHON_BIN}" -m coverage xml  -o ${COVERAGE_XML}
                                call "${PYTHON_BIN}" -m coverage json -o ${COVERAGE_JSON}
                                exit /b %EXITCODE%
                            """.stripIndent())

                            echo "Unit exit code: ${rc} (stage stays green by requirement)"
                        }
                    }
                    post {
                        always {
                            /*
                             * Publica resultados de tests sin marcar build UNSTABLE.
                             * Esto mantiene el contrato: Unit stage siempre verde.
                             */
                            junit testResults: "${UNIT_JUNIT}", allowEmptyResults: true, skipMarkingBuildUnstable: true

                            /*
                             * Publica coverage para graficas/pintado en Jenkins UI.
                             * enabledForFailure permite registrar aun si el build va mal por otras gates.
                             */
                            recordCoverage(
                                enabledForFailure: true,
                                tools: [[parser: 'COBERTURA', pattern: "${COVERAGE_XML}"]],
                                sourceCodeRetention: 'EVERY_BUILD'
                            )

                            /*
                             * stash 'REPORTS' para consumirlo mas tarde en la stage Coverage.
                             * Incluye coverage.json y coverage.xml ya generados aqui.
                             */
                            stash name: 'REPORTS',
                                  includes: 'reports/**',
                                  allowEmpty: true,
                                  useDefaultExcludes: false
                        }
                    }
                }

                stage('Static + Security') {
                    /*
                     * Branch dedicado para analisis estatico y seguridad.
                     *
                     * IMPORTANTE (Reto 2 - executors):
                     * - Queremos que Static y Security se ejecuten "en paralelo" dentro del MISMO label (static-sec).
                     * - Para que el numero de executors tenga efecto visible, CADA rama debe reservar su propio executor
                     *   con node(label). Si no, ambas ramas compartirian el mismo executor ya reservado por el stage.
                     *
                     * Con executors=1 en el/los nodo(s) con label static-sec:
                     * - Una de las ramas quedara en cola ("waiting for next available executor").
                     * Con executors>=2:
                     * - Ambas ramas podran ejecutarse realmente a la vez.
                     */
                    steps {
                        script {
                            parallel(
                                "Static": {
                                    node(env.STATIC_SECURITY_AGENT_LABEL) {
                                        stage('Static') {
                                            logAgentInfo('Static')
											sleep(time: 10, unit: 'SECONDS')
                                            script {
                                                deleteDir()
                                                unstash 'SRC'
                                                ensureReportsDirs()

                                                /*
                                                 * Ejecuta flake8 en formato parseable.
                                                 * No falla por exit code; gate por conteo.
                                                 */
                                                runFlake8Pylint()

                                                int findings = countPylintLikeFindings(env.FLAKE8_GATE_REPORT)
                                                applyCountQualityGate('Flake8', findings, 8, 10)
                                            }

                                            /*
                                             * Post de la stage Static (version scripted):
                                             * Mantiene Warnings-NG solo para graficas/historico y archiva evidencia.
                                             */
                                            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                                                recordIssues(
                                                    id: 'flake8',
                                                    enabledForFailure: true,
                                                    tools: [pyLint(name: 'Flake8', pattern: "${FLAKE8_REPORT}")]
                                                )
                                            }

                                            archiveArtifacts artifacts: "${FLAKE8_REPORT},${FLAKE8_GATE_REPORT}",
											fingerprint: true,
											allowEmptyArchive: true
                                        }
                                    }
                                },

                                "Security": {
                                    node(env.STATIC_SECURITY_AGENT_LABEL) {
                                        stage('Security') {
                                            logAgentInfo('Security')
                                            script {
                                                deleteDir()
                                                unstash 'SRC'
                                                ensureReportsDirs()

                                                /*
                                                 * Bandit genera:
                                                 * - OUT para Warnings-NG
                                                 * - JSON para conteo determinista
                                                 */
                                                runBanditPylintStyle()

                                                int findings = countBanditFindingsFromJson(env.BANDIT_JSON)
                                                applyCountQualityGate('Bandit', findings, 2, 4)
                                            }

                                            /*
                                             * Post de la stage Security (version scripted)
                                             */
                                            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                                                recordIssues(
                                                    id: 'bandit',
                                                    enabledForFailure: true,
                                                    tools: [pyLint(name: 'Bandit', pattern: "${BANDIT_OUT}")]
                                                )
                                            }

                                            archiveArtifacts artifacts: "${BANDIT_OUT},${BANDIT_JSON}",
                                                             fingerprint: true,
                                                             allowEmptyArchive: true
                                        }
                                    }
                                }
                            )
                        }
                    }
                }

                stage('Rest + Performance') {
                    /*
                     * Branch que requiere levantar servicios y ejecutar pruebas REST y de carga.
                     * Se usa un agente separado (qa-perf) para evitar pisar recursos del primary.
                     *
                     * Nota:
                     * - Rest y Performance quedan SECUENCIALES para evitar colisiones de puertos/procesos
                     *   (ambas stages arrancan Flask en el mismo agente/puerto).
                     */
                    agent { label "${QA_PERF_AGENT_LABEL}" }
                    stages {

                        stage('Rest') {
                            steps {
                                logAgentInfo('Rest')
                                script {
                                    deleteDir()
                                    unstash 'SRC'
                                    ensureReportsDirs()

                                    checkWiremockJar()
                                    killByPort(env.FLASK_PORT)
                                    killByPort(env.WIREMOCK_PORT)

                                    startFlask()
                                    startWiremock()

                                    /*
                                     * Espera a que ambos servicios respondan antes de lanzar tests REST.
                                     */
                                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask')
                                    waitHttp200("http://127.0.0.1:${env.WIREMOCK_PORT}/__admin", 10, 2, 'Healthcheck Wiremock')

                                    /*
                                     * Ejecuta rest tests y conserva exit code,
                                     * pero NO falla el stage por requisito del enunciado.
                                     */
                                    int rc = bat(returnStatus: true, label: 'Pytest Rest', script: """
                                        @echo off
                                        set PYTHONPATH=.
                                        "${PYTHON_BIN}" -m pytest --junitxml=${REST_JUNIT} test\\rest
                                        exit /b %ERRORLEVEL%
                                    """.stripIndent())

                                    echo "Rest exit code: ${rc} (stage stays green by requirement)"
                                }
                            }
                            post {
                                always {
                                    /*
                                     * Limpieza obligatoria para no dejar procesos colgados en el agente.
                                     */
                                    script {
                                        killByPort(env.FLASK_PORT)
                                        killByPort(env.WIREMOCK_PORT)
                                    }
                                    junit testResults: "${REST_JUNIT}", allowEmptyResults: true, skipMarkingBuildUnstable: true
                                }
                            }
                        }

                        stage('Performance') {
                            steps {
                                logAgentInfo('Performance')
                                script {
                                    deleteDir()
                                    unstash 'SRC'
                                    ensureReportsDirs()

                                    checkJmeterJar()

                                    killByPort(env.FLASK_PORT)
                                    startFlask()
                                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask (Perf)')

                                    /*
                                     * Performance se marca en rojo si falla JMeter,
                                     * pero no aborta el pipeline completo.
                                     */
                                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                        runJmeter()
                                    }
                                }
                            }
                            post {
                                always {
                                    script { killByPort(env.FLASK_PORT) }

                                    /*
                                     * Publicacion del reporte JMeter para graficas/historico.
                                     * Umbrales:
                                     * - >=1% errors => UNSTABLE
                                     * - >=5% errors => FAILURE
                                     */
                                    perfReport(
                                        sourceDataFiles: "${JMETER_JTL}",
                                        errorUnstableThreshold: 1,
                                        errorFailedThreshold: 5,
                                        percentiles: '0,50,90,95,100'
                                    )

                                    archiveArtifacts artifacts: "${JMETER_JTL}", fingerprint: true, allowEmptyArchive: true
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Coverage') {
            /*
             * Stage final, secuencial, en primary:
             * - consume el stash 'REPORTS' generado en Unit.
             * - aplica gate propio por lineas y ramas sin re-ejecutar tests.
             */
            agent { label "${PRIMARY_AGENT_LABEL}" }
            steps {
                logAgentInfo('Coverage')
                script {
                    deleteDir()
                    unstash 'REPORTS'
                    ensureReportsDirs()

                    def (double linesPct, double branchesPct) = readCoveragePercents()
                    echo "Coverage lines: ${linesPct}%"
                    echo "Coverage branches: ${branchesPct}%"

                    /*
                     * Umbrales del enunciado (segun definicion usada en vuestro Jenkinsfile):
                     * - Lines:   <85 FAIL, 85..95 UNSTABLE, >95 OK
                     * - Branches:<80 FAIL, 80..90 UNSTABLE, >90 OK
                     */
                    boolean linesUnstable = (linesPct >= 85.0 && linesPct < 95.0)
                    boolean linesFail = (linesPct < 85.0)

                    boolean branchesUnstable = (branchesPct >= 80.0 && branchesPct < 90.0)
                    boolean branchesFail = (branchesPct < 80.0)

                    if (linesFail || branchesFail) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            error("Coverage unhealthy (lines=${linesPct}%, branches=${branchesPct}%)")
                        }
                        setBuildResultWorst('FAILURE')
                    } else if (linesUnstable || branchesUnstable) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            error("Coverage unstable (lines=${linesPct}%, branches=${branchesPct}%)")
                        }
                        setBuildResultWorst('UNSTABLE')
                    } else {
                        echo "Coverage OK"
                    }
                }
            }
            post {
                always {
                    /*
                     * Guarda coverage.* como evidencia.
                     * Permite revisar exactamente el JSON usado para el gate.
                     */
                    archiveArtifacts artifacts: "${COVERAGE_XML},${COVERAGE_JSON}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            /*
             * En pipelines con agent none no hay un workspace global asegurado en post.
             * La limpieza se hace por-branch via deleteDir().
             * Aqui solo dejamos constancia para el informe/defensa.
             */
            echo 'Post: skipped global cleanWs() because pipeline uses agent none.'
        }
    }
}