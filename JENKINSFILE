/*
 * ==========================================================
 * CP1.2 Jenkinsfile (Windows) - Deterministic quality gates
 * ==========================================================
 *
 * Idea general:
 * - Ejecutamos todas las pruebas del enunciado.
 * - Unit/Rest siempre VERDES (requisito).
 * - Static/Security/Coverage aplican umbrales del enunciado pero SIN detener el pipeline.
 * - Warnings-NG y Coverage plugin se usan para graficas/historico, pero los gates se controlan de forma determinista.
 *
 * Nota Windows:
 * - ASCII only para evitar problemas de encoding en Jenkins/Windows.
 * - Uso de venv via PYTHON_BIN para que el pipeline no dependa del PATH del servicio (SYSTEM).
 */

/* =========================
 * Helper functions
 * ========================= */

/*
 * Wrapper simple para bat() con label. Mejora legibilidad del log.
 */
def runBat(String label, String script) {
    bat(label: label, script: script)
}

/*
 * Requisito del enunciado en el reto de agentes:
 * - whoami, hostname, workspace por etapa.
 * Aunque este Jenkinsfile sea "agent unico", lo dejamos igual para consistencia y trazabilidad.
 */
def logAgentInfo(String stageName) {
    runBat("Agent info (${stageName})", """
        @echo off
        echo === Agent info: ${stageName} ===
        whoami
        hostname
        echo %WORKSPACE%
        exit /b 0
    """.stripIndent())
}

/*
 * Crear carpetas de reports siempre, para:
 * - Evitar fallos si el plugin intenta publicar un fichero que no existe.
 * - Evitar depender del estado previo del workspace.
 */
def ensureReportsDirs() {
    runBat('Ensure reports dirs', """
        @echo off
        if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%"
        if not exist "%REPORTS_UNIT_DIR%" mkdir "%REPORTS_UNIT_DIR%"
        if not exist "%REPORTS_REST_DIR%" mkdir "%REPORTS_REST_DIR%"
        if not exist "%REPORTS_STATIC_DIR%" mkdir "%REPORTS_STATIC_DIR%"
        if not exist "%REPORTS_SECURITY_DIR%" mkdir "%REPORTS_SECURITY_DIR%"
        if not exist "%REPORTS_COVERAGE_DIR%" mkdir "%REPORTS_COVERAGE_DIR%"
        if not exist "%REPORTS_PERFORMANCE_DIR%" mkdir "%REPORTS_PERFORMANCE_DIR%"
        exit /b 0
    """.stripIndent())
}

/*
 * Diagnostico del entorno:
 * - Como Jenkins corre como servicio (a menudo NT AUTHORITY\\SYSTEM), no se debe confiar en PATH del usuario.
 * - Imprimimos version de Python para trazabilidad.
 */
def prepWorkspaceVerbose() {
    runBat('Workspace info (verbose)', """
        @echo off
        echo === Workspace info ===
        whoami
        hostname
        echo %WORKSPACE%
        echo === Python ===
        "%PYTHON_BIN%" --version
        exit /b 0
    """.stripIndent())
}

/*
 * Wiremock: verificacion temprana para fallar rapido si falta el jar.
 * Evita perder tiempo levantando pruebas si no existe la herramienta.
 */
def checkWiremockJar() {
    runBat('Check Wiremock jar', """
        @echo off
        if exist "%WIREMOCK_JAR%" (echo Wiremock OK) else (echo Wiremock MISSING & exit /b 1)
        exit /b 0
    """.stripIndent())
}

/*
 * JMeter: misma idea. Fallar pronto si no esta instalado/configurado.
 */
def checkJmeterJar() {
    runBat('Check JMeter', """
        @echo off
        if exist "%JMETER_JAR%" (echo JMeter OK) else (echo JMeter MISSING & exit /b 1)
        exit /b 0
    """.stripIndent())
}

/*
 * Windows + servidores locales:
 * - Si una ejecucion anterior dejo Flask/Wiremock vivos, el siguiente build fallaria por "port in use".
 * - Matamos por puerto para idempotencia del pipeline.
 */
def killByPort(String port) {
    runBat("Stop processes on ${port}", """
        @echo off
        for /f "tokens=5" %%p in ('netstat -ano ^| findstr /R /C:":${port} .*LISTENING"') do (
            taskkill /F /PID %%p 1>nul 2>nul
        )
        exit /b 0
    """.stripIndent())
}

/*
 * Healthcheck activo:
 * - Esperar a HTTP 200 antes de lanzar tests o JMeter.
 * - Reduce flakiness por arranque lento.
 */
def waitHttp200(String url, int maxTries, int timeoutSec, String label) {
    runBat(label,
        '''
        @echo off
        for /L %%i in (1,1,%MAX_TRIES%) do (
            powershell -NoProfile -Command "try { (Invoke-WebRequest -UseBasicParsing '%URL%' -TimeoutSec %TIMEOUT%).StatusCode } catch { 0 }" ^
                | findstr "^200$" >nul && exit /b 0
            ping -n 2 127.0.0.1 >nul
        )
        exit /b 1
        '''
        .replace('%URL%', url)
        .replace('%MAX_TRIES%', maxTries.toString())
        .replace('%TIMEOUT%', timeoutSec.toString())
        .stripIndent()
    )
}

/*
 * Flask se levanta en background:
 * - Requisito para Rest y Performance.
 * - --no-reload para evitar procesos duplicados.
 */
def startFlask() {
    runBat('Start Flask', """
        @echo off
        set PYTHONPATH=.
        set FLASK_APP=app\\api.py
        start "" /B "%PYTHON_BIN%" -m flask run --host 127.0.0.1 --port %FLASK_PORT% --no-reload
        exit /b 0
    """.stripIndent())
}

/*
 * Wiremock para tests Rest:
 * - Se lanza con root-dir apuntando a test\\wiremock (mappings, etc.).
 */
def startWiremock() {
    runBat('Start Wiremock', """
        @echo off
        start "" /B java -jar "%WIREMOCK_JAR%" --port %WIREMOCK_PORT% --root-dir test\\wiremock
        exit /b 0
    """.stripIndent())
}

/*
 * Flake8:
 * - --exit-zero para que flake8 NO decida el resultado Jenkins.
 * - Gate real se aplica despues por conteo de hallazgos (enunciado).
 */
def runFlake8Pylint() {
    runBat('Flake8', """
        @echo off
        set PYTHONPATH=.

        "%PYTHON_BIN%" -m flake8 app\\api.py app\\calc.py ^
            --exit-zero ^
            --format="%(path)s:%(row)d:%(col)d: %(code)s %(text)s" ^
            > "%FLAKE8_REPORT%"

        exit /b 0
    """.stripIndent())
}

/*
 * Bandit:
 * - Mismo enfoque: --exit-zero para no abortar.
 * - Generamos:
 *   - bandit.out en formato "pylint-like" para Warnings-NG (graficas).
 *   - bandit.json para conteo determinista (len(results)).
 * Nota: {test_id}/{msg} son placeholders de bandit (no Groovy).
 */
def runBanditPylintStyle() {
    runBat('Bandit', """
        @echo off
        set PYTHONPATH=.

        rem Scan app + test folders (same scope as shown in class)
        "%PYTHON_BIN%" -m bandit --exit-zero -r app test -f custom -o "%BANDIT_OUT%" --msg-template "{abspath}:{line}: [{test_id}] {msg}"
        "%PYTHON_BIN%" -m bandit --exit-zero -r app test -f json   -o "%BANDIT_JSON%"

        exit /b 0
    """.stripIndent())
}

/*
 * JMeter no-GUI:
 * - Limpia el .jtl anterior para no mezclar resultados.
 * - Si falla JMeter, devolvemos su ERRORLEVEL para poder marcar stage rojo (pero sin parar pipeline via catchError).
 */
def runJmeter() {
    runBat('JMeter', """
        @echo off
        if exist "%JMETER_JTL%" del /q "%JMETER_JTL%" 1>nul 2>nul
        java -jar "%JMETER_JAR%" -n -t "%JMETER_TESTPLAN%" -l "%JMETER_JTL%"
        exit /b %ERRORLEVEL%
    """.stripIndent())
}

/*
 * Build result escalator:
 * - Evita que el build "mejore" al final si ya hubo un FAIL antes.
 * - Regla: SUCCESS < UNSTABLE < FAILURE.
 * - Se usa tras aplicar gates (Static/Security/Coverage).
 */
def setBuildResultWorst(String target) {
    String current = (currentBuild.result ?: 'SUCCESS')
    Map<String, Integer> rank = ['SUCCESS': 0, 'UNSTABLE': 1, 'FAILURE': 2]
    int curRank = rank.containsKey(current) ? rank[current] : 0
    int tgtRank = rank.containsKey(target) ? rank[target] : 0

    if (tgtRank > curRank) {
        currentBuild.result = target
        echo "Build result escalated: ${current} -> ${target}"
    } else {
        echo "Build result unchanged: ${current} (requested ${target})"
    }
}

/*
 * Conteo determinista de hallazgos:
 * - Flake8 en formato pylint: 1 hallazgo por linea (no vacia).
 * - Se cuenta con un mini-script Python para evitar dependencias extra.
 */
def countPylintLikeFindings(String reportPath) {
    String out = bat(
        label: "Count findings in ${reportPath}",
        returnStdout: true,
        script: """
            @echo off
            if not exist "${reportPath}" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "p=r'''${reportPath}'''; f=open(p,'r',encoding='utf-8',errors='ignore'); print(sum(1 for line in f if line.strip()))"
            exit /b 0
        """.stripIndent()
    ).trim()

    return out ? out.toInteger() : 0
}

/*
 * Conteo determinista bandit:
 * - Se usa bandit.json y se cuenta len(results).
 * - Esto evita depender del formato de texto para gates.
 */
def countBanditFindingsFromJson(String banditJsonPath) {
    String out = bat(
        label: "Count bandit findings in ${banditJsonPath}",
        returnStdout: true,
        script: """
            @echo off
            if not exist "${banditJsonPath}" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; p=r'''${banditJsonPath}'''; d=json.load(open(p,'r',encoding='utf-8',errors='ignore')); print(len(d.get('results', [])))"
            exit /b 0
        """.stripIndent()
    ).trim()

    return out ? out.toInteger() : 0
}

/*
 * Aplicacion de gates por conteo:
 * - stageResult marca la etapa (amarillo/rojo) pero buildResult se deja SUCCESS dentro del catchError para NO abortar pipeline.
 * - setBuildResultWorst aplica el resultado global al peor nivel alcanzado.
 * Umbrales (enunciado):
 * - Flake8: unstable >= 8, failure >= 10
 * - Bandit: unstable >= 2, failure >= 4
 */
def applyCountQualityGate(String stageLabel, int findings, int unstableFrom, int failureFrom) {
    echo "${stageLabel} findings = ${findings} (unstable>=${unstableFrom}, failure>=${failureFrom})"

    if (findings >= failureFrom) {
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            error("${stageLabel} unhealthy: ${findings} findings (>=${failureFrom})")
        }
        setBuildResultWorst('FAILURE')
        return
    }

    if (findings >= unstableFrom) {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
            error("${stageLabel} unstable: ${findings} findings (>=${unstableFrom})")
        }
        setBuildResultWorst('UNSTABLE')
        return
    }

    echo "${stageLabel} OK"
}

/*
 * Lectura de cobertura sin re-ejecutar Unit:
 * - Requisito: tests unitarios solo se ejecutan 1 vez en el pipeline.
 * - Unit genera coverage.json; Coverage solo lo lee y calcula % lineas y % ramas.
 */
def readCoveragePercents() {
    String outLines = bat(
        label: 'Read coverage percent (lines)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import os,json; p=os.environ.get('COVERAGE_JSON'); d=json.load(open(p)); t=d.get('totals',{}); print(f\\\"{t.get('percent_covered',0):.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    String outBranches = bat(
        label: 'Read coverage percent (branches)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import os,json; p=os.environ.get('COVERAGE_JSON'); d=json.load(open(p)); t=d.get('totals',{}); cb=t.get('covered_branches',0); nb=t.get('num_branches',0); pct=(cb*100.0/nb) if nb else 0.0; print(f\\\"{pct:.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    double linesPct = outLines ? outLines.toDouble() : 0.0
    double branchesPct = outBranches ? outBranches.toDouble() : 0.0
    return [linesPct, branchesPct]
}

/* =========================
 * Pipeline
 * ========================= */

pipeline {
    /*
     * Agente unico:
     * - Este Jenkinsfile es la version "reto 1" (sin distribucion de agentes).
     */
    agent any

    options {
        /*
         * timestamps: facilita lectura del log y evidencia de paralelismo/esperas (en otras variantes).
         * skipDefaultCheckout: evitamos el checkout automatico porque controlamos el checkout en "Get Code".
         */
        timestamps()
        skipDefaultCheckout(true)
    }

    environment {
        /*
         * PYTHON_BIN fijo al venv:
         * - Reproducibilidad. Evita depender de PATH del servicio Jenkins (SYSTEM).
         */
        PYTHON_BIN = 'C:\\ci\\venvs\\cp1\\Scripts\\python.exe'

        /*
         * Estructura de reports: cada herramienta escribe en su carpeta.
         */
        REPORTS_DIR = 'reports'
        REPORTS_UNIT_DIR = 'reports\\unit'
        REPORTS_REST_DIR = 'reports\\rest'
        REPORTS_STATIC_DIR = 'reports\\static'
        REPORTS_SECURITY_DIR = 'reports\\security'
        REPORTS_COVERAGE_DIR = 'reports\\coverage'
        REPORTS_PERFORMANCE_DIR = 'reports\\performance'

        /*
         * Paths de outputs para plugins:
         * - junit (unit/rest)
         * - coverage plugin (xml)
         * - gates coverage (json)
         */
        UNIT_JUNIT = 'reports\\unit\\result-unit.xml'
        REST_JUNIT = 'reports\\rest\\result-rest.xml'
        COVERAGE_XML = 'reports\\coverage\\coverage.xml'
        COVERAGE_JSON = 'reports\\coverage\\coverage.json'

        /*
         * Outputs static/security para Warnings-NG y gates.
         */
        FLAKE8_REPORT = 'reports\\static\\flake8.out'
        BANDIT_OUT = 'reports\\security\\bandit.out'
        BANDIT_JSON = 'reports\\security\\bandit.json'

        /*
         * Puertos locales para Flask/Wiremock.
         */
        FLASK_PORT = '5000'
        WIREMOCK_PORT = '9090'

        /*
         * Herramientas locales:
         * - jar de wiremock
         * - jar de jmeter (distribucion de jmeter)
         */
        WIREMOCK_JAR = 'C:\\ci\\tools\\wiremock-standalone-3.13.2.jar'
        JMETER_JAR = 'C:\\ci\\tools\\apache-jmeter-5.6.3\\bin\\ApacheJMeter.jar'
        JMETER_TESTPLAN = 'test\\jmeter\\flask.jmx'
        JMETER_JTL = 'reports\\performance\\jmeter.jtl'

        /*
         * SCM:
         * - repo y branch objetivo.
         */
        REPO_URL = 'https://github.com/alloci88/CP1.git'
        REPO_BRANCH = '*/master'
    }

    stages {

        stage('Get Code') {
            steps {
                /*
                 * Checkout controlado + stash del codigo:
                 * - stash/unstash se usa incluso en agente unico para mantener compatibilidad con JENKINSFILE_agentes.
                 * - Excluimos reports/coverage/__pycache__ para no arrastrar artefactos de builds previos.
                 */
                logAgentInfo('Get Code')

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${REPO_BRANCH}"]],
                    userRemoteConfigs: [[url: "${REPO_URL}"]]
                ])

                prepWorkspaceVerbose()
                ensureReportsDirs()

                stash name: 'SRC',
                      includes: '**/*',
                      excludes: '.git/**,reports/**,coverage/**,**/__pycache__/**',
                      useDefaultExcludes: false
            }
        }

        stage('Unit') {
            steps {
                /*
                 * Unit:
                 * - Ejecuta pytest UNA sola vez.
                 * - Genera junitxml + coverage xml/json.
                 * - Se captura exit code pero NO se degrada el stage (requisito: siempre verde).
                 */
                logAgentInfo('Unit')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    int rc = bat(returnStatus: true, label: 'Pytest Unit + Coverage', script: """
                        @echo off
                        call "${PYTHON_BIN}" -m coverage run --branch -m pytest --junitxml=${UNIT_JUNIT} test\\unit
                        set EXITCODE=%ERRORLEVEL%
                        call "${PYTHON_BIN}" -m coverage xml  -o ${COVERAGE_XML}
                        call "${PYTHON_BIN}" -m coverage json -o ${COVERAGE_JSON}
                        exit /b %EXITCODE%
                    """.stripIndent())

                    echo "Unit exit code: ${rc} (stage stays green by requirement)"
                }
            }
            post {
                always {
                    /*
                     * Publicacion resultados:
                     * - junit: grafica de tests. skipMarkingBuildUnstable para no cambiar estado.
                     * - recordCoverage: graficas de cobertura en Jenkins.
                     * - stash REPORTS: necesario para la etapa Coverage (leer coverage.json) sin re-ejecutar tests.
                     */
                    junit testResults: "${UNIT_JUNIT}", allowEmptyResults: true, skipMarkingBuildUnstable: true

                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: "${COVERAGE_XML}"]],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )

                    stash name: 'REPORTS',
                          includes: 'reports/**',
                          allowEmpty: true,
                          useDefaultExcludes: false
                }
            }
        }

        stage('Rest') {
            steps {
                /*
                 * Integracion:
                 * - Arranca Flask + Wiremock en background.
                 * - Healthchecks 200 antes de test.
                 * - Ejecuta pytest rest y publica junit.
                 * - Siempre verde por requisito.
                 */
                logAgentInfo('Rest')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    checkWiremockJar()
                    killByPort(env.FLASK_PORT)
                    killByPort(env.WIREMOCK_PORT)

                    startFlask()
                    startWiremock()

                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask')
                    waitHttp200("http://127.0.0.1:${env.WIREMOCK_PORT}/__admin", 10, 2, 'Healthcheck Wiremock')

                    int rc = bat(returnStatus: true, label: 'Pytest Rest', script: """
                        @echo off
                        set PYTHONPATH=.
                        "${PYTHON_BIN}" -m pytest --junitxml=${REST_JUNIT} test\\rest
                        exit /b %ERRORLEVEL%
                    """.stripIndent())

                    echo "Rest exit code: ${rc} (stage stays green by requirement)"
                }
            }
            post {
                always {
                    /*
                     * Limpieza de puertos SIEMPRE:
                     * - Evita que procesos colgados rompan builds posteriores.
                     */
                    script {
                        killByPort(env.FLASK_PORT)
                        killByPort(env.WIREMOCK_PORT)
                    }

                    junit testResults: "${REST_JUNIT}", allowEmptyResults: true, skipMarkingBuildUnstable: true
                }
            }
        }

        stage('Static') {
            steps {
                /*
                 * Static:
                 * - Flake8 escribe reporte en formato pylint.
                 * - Se cuenta hallazgos y se aplican umbrales del enunciado:
                 *   unstable >= 8, failure >= 10.
                 * - Se marca stage/build pero NO se detiene pipeline.
                 */
                logAgentInfo('Static')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    runFlake8Pylint()

                    int findings = countPylintLikeFindings(env.FLAKE8_REPORT)
                    applyCountQualityGate('Flake8', findings, 8, 10)
                }
            }
            post {
                always {
                    /*
                     * Warnings-NG:
                     * - Solo graficas/historico. No usamos sus quality gates para que el gate sea determinista y calcado al enunciado.
                     * - catchError aqui evita que un fallo del plugin impida el build.
                     */
                    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                        recordIssues(
                            id: 'flake8',
                            enabledForFailure: true,
                            tools: [pyLint(name: 'Flake8', pattern: "${FLAKE8_REPORT}")]
                        )
                    }

                    archiveArtifacts artifacts: "${FLAKE8_REPORT}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        stage('Security') {
            steps {
                /*
                 * Security:
                 * - Bandit genera reporte pylint-like + JSON.
                 * - Gate por conteo JSON con umbrales del enunciado:
                 *   unstable >= 2, failure >= 4.
                 */
                logAgentInfo('Security')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    runBanditPylintStyle()

                    int findings = countBanditFindingsFromJson(env.BANDIT_JSON)
                    applyCountQualityGate('Bandit', findings, 2, 4)
                }
            }
            post {
                always {
                    /*
                     * Warnings-NG para historico.
                     */
                    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                        recordIssues(
                            id: 'bandit',
                            enabledForFailure: true,
                            tools: [pyLint(name: 'Bandit', pattern: "${BANDIT_OUT}")]
                        )
                    }

                    archiveArtifacts artifacts: "${BANDIT_OUT},${BANDIT_JSON}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        stage('Performance') {
            steps {
                /*
                 * Performance:
                 * - Requisito: ejecutar test-plan JMeter con Flask levantado.
                 * - No necesita Wiremock (solo suma/resta).
                 * - catchError marca etapa roja si JMeter falla, pero pipeline continua.
                 */
                logAgentInfo('Performance')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    checkJmeterJar()

                    killByPort(env.FLASK_PORT)
                    startFlask()
                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask (Perf)')

                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                        runJmeter()
                    }
                }
            }
            post {
                always {
                    /*
                     * Siempre matamos Flask y publicamos:
                     * - perfReport para graficas (incluye percentiles: 90 requerido).
                     * - archiveArtifacts del .jtl para evidencia.
                     */
                    script { killByPort(env.FLASK_PORT) }

                    perfReport(
                        sourceDataFiles: "${JMETER_JTL}",
                        errorUnstableThreshold: 1,
                        errorFailedThreshold: 5,
                        percentiles: '0,50,90,95,100'
                    )

                    archiveArtifacts artifacts: "${JMETER_JTL}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }
		stage('Coverage') {
			steps {
			  /*
                 * Coverage:
                 * - No re-ejecuta pytest.
                 * - Lee coverage.json generado en Unit (stash REPORTS).
                 * - Aplica umbrales del enunciado para lineas y ramas:
                 *   Lineas: 85-95 UNSTABLE, <85 FAILURE.
                 *   Ramas:  80-90 UNSTABLE, <80 FAILURE.
                 * - Marca stage/build pero NO detiene pipeline.
                 */
				logAgentInfo('Coverage')
				script {
					deleteDir()
					unstash 'REPORTS'
					ensureReportsDirs()
		
					def (double linesPct, double branchesPct) = readCoveragePercents()
					echo "Coverage lines: ${linesPct}%"
					echo "Coverage branches: ${branchesPct}%"
		
					boolean linesUnstable = (linesPct >= 85.0 && linesPct < 95.0)
					boolean linesFail = (linesPct < 85.0)
		
					boolean branchesUnstable = (branchesPct >= 80.0 && branchesPct < 90.0)
					boolean branchesFail = (branchesPct < 80.0)
		
					if (linesFail || branchesFail) {
						catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
							error("Coverage unhealthy (lines=${linesPct}%, branches=${branchesPct}%)")
						}
						setBuildResultWorst('FAILURE')
					} else if (linesUnstable || branchesUnstable) {
						catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
							error("Coverage unstable (lines=${linesPct}%, branches=${branchesPct}%)")
						}
						setBuildResultWorst('UNSTABLE')
					} else {
						echo "Coverage OK"
					}
				}
			}
			post {
				always {
					/*
                     * Archivado de coverage outputs para evidencia y auditoria.
                     */
					archiveArtifacts artifacts: "${COVERAGE_XML},${COVERAGE_JSON}", fingerprint: true, allowEmptyArchive: true
				}
			}
		}
	}

    post {
        always {
            /*
             * Limpieza final:
             * - Evita contaminacion entre builds (especialmente en Windows).
             * - deleteDirs true para borrar subcarpetas generadas por herramientas/plugins.
             */
            cleanWs(deleteDirs: true)
        }
    }
}
