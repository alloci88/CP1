pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        PYTHON_BIN = 'python'
        REPORTS_DIR = 'reports'

        UNIT_JUNIT = 'reports\\result-unit.xml'
        REST_JUNIT = 'reports\\result-rest.xml'

        FLASK_PORT = '5000'
        WIREMOCK_PORT = '9090'
        WIREMOCK_JAR = 'C:\\UNIR\\Ejercicios\\wiremock-jre8-standalone-2.28.0.jar'
    }

    stages {

        stage('Get Code') {
            steps {
                checkout scm
                bat 'dir'
                bat 'whoami'
                bat 'hostname'
                bat 'echo %WORKSPACE%'
                bat "if not exist %REPORTS_DIR% mkdir %REPORTS_DIR%"
            }
        }

        stage('Unit') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    bat """
                        set PYTHONPATH=.
                        %PYTHON_BIN% -m pytest --junitxml=%UNIT_JUNIT% test\\unit
                    """
                }
            }
            post {
                always {
                    junit testResults: "${UNIT_JUNIT}", allowEmptyResults: true
                }
            }
        }

        stage('Rest') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    bat """
                        set PYTHONPATH=.
                        set FLASK_APP=app\\api.py

                        REM Arrancar Flask
                        start /B %PYTHON_BIN% -m flask run --port %FLASK_PORT%

                        REM Arrancar Wiremock
                        start /B java -jar "%WIREMOCK_JAR%" --port %WIREMOCK_PORT% --root-dir test\\wiremock

                        REM Espera para que levanten servicios
                        ping -n 10 127.0.0.1 > nul

                        %PYTHON_BIN% -m pytest --junitxml=%REST_JUNIT% test\\rest

                        REM Parar procesos por puerto
                        for /f "tokens=5" %%a in ('netstat -ano ^| findstr :%FLASK_PORT% ^| findstr LISTENING') do taskkill /F /PID %%a
                        for /f "tokens=5" %%a in ('netstat -ano ^| findstr :%WIREMOCK_PORT% ^| findstr LISTENING') do taskkill /F /PID %%a
                    """
                }
            }
            post {
                always {
                    junit testResults: "${REST_JUNIT}", allowEmptyResults: true
                }
            }
        }
    }
}