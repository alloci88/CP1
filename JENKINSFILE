pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        PYTHON_BIN = 'C:\\ci\\venvs\\cp1\\Scripts\\python.exe'

        REPORTS_DIR = 'reports'
        UNIT_JUNIT = 'reports\\result-unit.xml'
        REST_JUNIT = 'reports\\result-rest.xml'

        FLASK_PORT = '5000'
        WIREMOCK_PORT = '9090'

        WIREMOCK_JAR = 'C:\\Users\\alcil\\OneDrive\\Escritorio\\Unir\\Ejercicios\\wiremock-standalone-3.13.2.jar'
    }

    stages {

        stage('Get Code') {
            steps {
                checkout scm
                bat 'dir'
                bat 'whoami'
                bat 'hostname'
                bat 'echo %WORKSPACE%'
                bat "if not exist %REPORTS_DIR% mkdir %REPORTS_DIR%"
                bat "\"%PYTHON_BIN%\" --version"
                bat "if exist \"%WIREMOCK_JAR%\" (echo Wiremock OK) else (echo Wiremock NO EXISTE & exit /b 1)"
            }
        }

        stage('Unit') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    bat '''
                        set PYTHONPATH=.
                        "%PYTHON_BIN%" -m pytest --junitxml=%UNIT_JUNIT% test\\unit
                    '''
                }
            }
            post {
                always {
                    junit testResults: "${UNIT_JUNIT}", allowEmptyResults: true
                }
            }
        }

        stage('Rest') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    bat '''
                        set PYTHONPATH=.
                        set FLASK_APP=app\\api.py

                        REM Limpieza preventiva por si quedo algo colgado (NO fallar si no hay nada)
                        for /F "tokens=5" %%a in ('netstat -ano ^| findstr :%FLASK_PORT% ^| findstr LISTENING') do (taskkill /F /PID %%a 2>nul ^&^& echo Killed PID %%a on %FLASK_PORT% ^|^| echo PID %%a already dead)
                        for /F "tokens=5" %%a in ('netstat -ano ^| findstr :%WIREMOCK_PORT% ^| findstr LISTENING') do (taskkill /F /PID %%a 2>nul ^&^& echo Killed PID %%a on %WIREMOCK_PORT% ^|^| echo PID %%a already dead)

                        REM Arrancar Flask (background) - start "" para rutas con espacios + sin reload
                        start "" /B "%PYTHON_BIN%" -m flask run --host 127.0.0.1 --port %FLASK_PORT% --no-reload

                        REM Arrancar Wiremock (background)
                        start "" /B java -jar "%WIREMOCK_JAR%" --port %WIREMOCK_PORT% --root-dir test\\wiremock

                        REM Healthcheck Flask (hasta 10 intentos)
                        for /L %%i in (1,1,10) do (
                            powershell -NoProfile -Command "try { (Invoke-WebRequest -UseBasicParsing http://127.0.0.1:%FLASK_PORT%/ -TimeoutSec 2).StatusCode } catch { 0 }" | findstr /R "^200$" >nul && goto flask_ok
                            ping -n 2 127.0.0.1 > nul
                        )
                        echo Flask no ha levantado en tiempo razonable
                        exit /b 1
                        :flask_ok

                        REM Healthcheck Wiremock (__admin deberia responder 200)
                        for /L %%i in (1,1,10) do (
                            powershell -NoProfile -Command "try { (Invoke-WebRequest -UseBasicParsing http://127.0.0.1:%WIREMOCK_PORT%/__admin -TimeoutSec 2).StatusCode } catch { 0 }" | findstr /R "^200$" >nul && goto wm_ok
                            ping -n 2 127.0.0.1 > nul
                        )
                        echo Wiremock no ha levantado en tiempo razonable
                        exit /b 1
                        :wm_ok

                        "%PYTHON_BIN%" -m pytest --junitxml=%REST_JUNIT% test\\rest

                        REM Parar procesos por puerto (NO fallar si ya no existen)
                        for /F "tokens=5" %%a in ('netstat -ano ^| findstr :%FLASK_PORT% ^| findstr LISTENING') do (taskkill /F /PID %%a 2>nul ^&^& echo Killed PID %%a on %FLASK_PORT% ^|^| echo PID %%a already dead)
                        for /F "tokens=5" %%a in ('netstat -ano ^| findstr :%WIREMOCK_PORT% ^| findstr LISTENING') do (taskkill /F /PID %%a 2>nul ^&^& echo Killed PID %%a on %WIREMOCK_PORT% ^|^| echo PID %%a already dead)
                    '''
                }
            }
            post {
                always {
                    junit testResults: "${REST_JUNIT}", allowEmptyResults: true
                }
            }
        }
    }
}

