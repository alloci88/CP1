/*
 * ==========================================================
 * CP1.2 Jenkinsfile (Windows)
 * ==========================================================
 *
 * Objetivos (enunciado/guia):
 * - Stages: Get Code, Unit, Rest, Static, Security, Performance, Coverage
 * - Unit y Rest: siempre VERDES (aunque fallen tests).
 * - Static/Security/Coverage: aplicar umbrales, pero el pipeline debe CONTINUAR siempre.
 * - Unit tests: SOLO se ejecutan UNA vez en TODO el pipeline.
 * - Publicar resultados en cada etapa (sin etapa "Results").
 * - Preparado para Reto 2: whoami/hostname/workspace en CADA etapa + stash/unstash.
 *
 * Nota:
 * - Flake8 y Bandit se formatean para que Warnings-NG los lea con parser "Pylint"
 *   (como el profesor), y se aplican qualityGates ahí (menos Groovy, más plugin).
 * - Bandit NO usa SARIF (más limpio). Se usa -f custom + --msg-template para producir
 *   un output estilo pylint.
 *
 * NOTE: ASCII only to avoid encoding issues in Jenkins on Windows.
 */

/* =========================
 * Helper functions
 * ========================= */

/** Ejecuta un comando batch con etiqueta clara en log */
def runBat(String label, String script) {
    bat(label: label, script: script)
}

/**
 * Reto 2: En cada etapa deben aparecer whoami/hostname/workspace.
 * (Si agentes comparten usuario, WORKSPACE ayuda a distinguir).
 */
def logAgentInfo(String stageName) {
    runBat("Agent info (${stageName})", """
        @echo off
        echo === Agent info: ${stageName} ===
        whoami
        hostname
        echo %WORKSPACE%
        exit /b 0
    """.stripIndent())
}

/** Crea estructura de carpetas de reports (idempotente). */
def ensureReportsDirs() {
    runBat('Ensure reports dirs', """
        @echo off
        if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%"
        if not exist "%REPORTS_UNIT_DIR%" mkdir "%REPORTS_UNIT_DIR%"
        if not exist "%REPORTS_REST_DIR%" mkdir "%REPORTS_REST_DIR%"
        if not exist "%REPORTS_STATIC_DIR%" mkdir "%REPORTS_STATIC_DIR%"
        if not exist "%REPORTS_SECURITY_DIR%" mkdir "%REPORTS_SECURITY_DIR%"
        if not exist "%REPORTS_COVERAGE_DIR%" mkdir "%REPORTS_COVERAGE_DIR%"
        if not exist "%REPORTS_PERFORMANCE_DIR%" mkdir "%REPORTS_PERFORMANCE_DIR%"
        exit /b 0
    """.stripIndent())
}

/** Log verboso SOLO una vez (útil para Reto 1). */
def prepWorkspaceVerbose() {
    runBat('Workspace info (verbose)', """
        @echo off
        echo === Workspace info ===
        whoami
        hostname
        echo %WORKSPACE%
        echo === Python ===
        "%PYTHON_BIN%" --version
        exit /b 0
    """.stripIndent())
}

/** Verifica Wiremock JAR. */
def checkWiremockJar() {
    runBat('Check Wiremock jar', """
        @echo off
        if exist "%WIREMOCK_JAR%" (echo Wiremock OK) else (echo Wiremock MISSING & exit /b 1)
        exit /b 0
    """.stripIndent())
}

/** Verifica JMeter (jar). */
def checkJmeterJar() {
    runBat('Check JMeter', """
        @echo off
        if exist "%JMETER_JAR%" (echo JMeter OK) else (echo JMeter MISSING & exit /b 1)
        exit /b 0
    """.stripIndent())
}

/**
 * Mata el proceso que esté escuchando en un puerto concreto.
 * Evita flakiness por servicios "huérfanos" de ejecuciones previas.
 */
def killByPort(String port) {
    runBat("Stop processes on ${port}", """
        @echo off
        for /f "tokens=5" %%p in ('netstat -ano ^| findstr /R /C:":${port} .*LISTENING"') do (
            taskkill /F /PID %%p 1>nul 2>nul
        )
        exit /b 0
    """.stripIndent())
}

/**
 * Espera hasta recibir HTTP 200 en una URL (healthcheck).
 * Reduce flakiness por arranque asíncrono de Flask/Wiremock.
 */
def waitHttp200(String url, int maxTries, int timeoutSec, String label) {
    runBat(label,
        '''
        @echo off
        for /L %%i in (1,1,%MAX_TRIES%) do (
            powershell -NoProfile -Command "try { (Invoke-WebRequest -UseBasicParsing '%URL%' -TimeoutSec %TIMEOUT%).StatusCode } catch { 0 }" ^
                | findstr "^200$" >nul && exit /b 0
            ping -n 2 127.0.0.1 >nul
        )
        exit /b 1
        '''
        .replace('%URL%', url)
        .replace('%MAX_TRIES%', maxTries.toString())
        .replace('%TIMEOUT%', timeoutSec.toString())
        .stripIndent()
    )
}

/** Arranca Flask en background. */
def startFlask() {
    runBat('Start Flask', """
        @echo off
        set PYTHONPATH=.
        set FLASK_APP=app\\api.py
        start "" /B "%PYTHON_BIN%" -m flask run --host 127.0.0.1 --port %FLASK_PORT% --no-reload
        exit /b 0
    """.stripIndent())
}

/** Arranca Wiremock en background. */
def startWiremock() {
    runBat('Start Wiremock', """
        @echo off
        start "" /B java -jar "%WIREMOCK_JAR%" --port %WIREMOCK_PORT% --root-dir test\\wiremock
        exit /b 0
    """.stripIndent())
}

/**
 * Flake8 en formato parseable por Warnings-NG usando parser Pylint:
 * - --exit-zero: siempre exit 0 (pipeline sigue)
 * - --format=pylint: salida "path:line:col: code msg" (compatible con Pylint parser)
 */
def runFlake8Pylint() {
    runBat('Flake8', """
        @echo off
        set PYTHONPATH=.
        "%PYTHON_BIN%" -m flake8 app test --exit-zero --format=pylint > "%FLAKE8_REPORT%"
        exit /b 0
    """.stripIndent())
}

/**
 * Bandit "profesor style" para Warnings-NG:
 * - --exit-zero: siempre exit 0 (pipeline sigue)
 * - -f custom + --msg-template: emitimos líneas estilo pylint
 *   Formato resultante: "<path>:<line>: [<test_id>] <msg>"
 * - Lo parseamos con parser Pylint (pyLint tool) en Warnings-NG.
 */
def runBanditPylintStyle() {
    runBat('Bandit', """
        @echo off
        set PYTHONPATH=.
        "%PYTHON_BIN%" -m bandit --exit-zero -r app -f custom -o "%BANDIT_OUT%" --msg-template "{abspath}:{line}: [{test_id}] {msg}"
        "%PYTHON_BIN%" -m bandit --exit-zero -r app -f json   -o "%BANDIT_JSON%"
        exit /b 0
    """.stripIndent())
}

/** Ejecuta JMeter (no-GUI) usando el test plan .jmx y genera .jtl. */
def runJmeter() {
    runBat('JMeter', """
        @echo off
        if exist "%JMETER_JTL%" del /q "%JMETER_JTL%" 1>nul 2>nul
        java -jar "%JMETER_JAR%" -n -t "%JMETER_TESTPLAN%" -l "%JMETER_JTL%"
        exit /b %ERRORLEVEL%
    """.stripIndent())
}

/**
 * Escalador de estado del build:
 * mantiene el "peor" resultado entre stages independientes.
 */
def setBuildResultWorst(String target) {
    String current = (currentBuild.result ?: 'SUCCESS')
    Map<String, Integer> rank = ['SUCCESS': 0, 'UNSTABLE': 1, 'FAILURE': 2]
    int curRank = rank.containsKey(current) ? rank[current] : 0
    int tgtRank = rank.containsKey(target) ? rank[target] : 0

    if (tgtRank > curRank) {
        currentBuild.result = target
        echo "Build result escalated: ${current} -> ${target}"
    } else {
        echo "Build result unchanged: ${current} (requested ${target})"
    }
}

/**
 * Lee porcentajes desde coverage.json (creado en Unit).
 * NO se re-ejecutan unit tests (requisito del enunciado).
 */
def readCoveragePercents() {
    String outLines = bat(
        label: 'Read coverage percent (lines)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; d=json.load(open(r'%COVERAGE_JSON%')); t=d.get('totals',{}); print(f\\\"{t.get('percent_covered',0):.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    String outBranches = bat(
        label: 'Read coverage percent (branches)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; d=json.load(open(r'%COVERAGE_JSON%')); t=d.get('totals',{}); cb=t.get('covered_branches',0); nb=t.get('num_branches',0); pct=(cb*100.0/nb) if nb else 0.0; print(f\\\"{pct:.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    double linesPct = outLines ? outLines.toDouble() : 0.0
    double branchesPct = outBranches ? outBranches.toDouble() : 0.0
    return [linesPct, branchesPct]
}

/* =========================
 * Pipeline
 * ========================= */

pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)  // hacemos checkout en "Get Code" manualmente
    }

    environment {
        PYTHON_BIN = 'C:\\ci\\venvs\\cp1\\Scripts\\python.exe'

        REPORTS_DIR = 'reports'
        REPORTS_UNIT_DIR = 'reports\\unit'
        REPORTS_REST_DIR = 'reports\\rest'
        REPORTS_STATIC_DIR = 'reports\\static'
        REPORTS_SECURITY_DIR = 'reports\\security'
        REPORTS_COVERAGE_DIR = 'reports\\coverage'
        REPORTS_PERFORMANCE_DIR = 'reports\\performance'

        UNIT_JUNIT = 'reports\\unit\\result-unit.xml'
        REST_JUNIT = 'reports\\rest\\result-rest.xml'
        COVERAGE_XML = 'reports\\coverage\\coverage.xml'
        COVERAGE_JSON = 'reports\\coverage\\coverage.json'

        FLAKE8_REPORT = 'reports\\static\\flake8.out'

        BANDIT_OUT = 'reports\\security\\bandit.out'
        BANDIT_JSON = 'reports\\security\\bandit.json'

        FLASK_PORT = '5000'
        WIREMOCK_PORT = '9090'

        WIREMOCK_JAR = 'C:\\ci\\tools\\wiremock-standalone-3.13.2.jar'

        JMETER_JAR = 'C:\\ci\\tools\\apache-jmeter-5.6.3\\bin\\ApacheJMeter.jar'
        JMETER_TESTPLAN = 'test\\jmeter\\flask.jmx'
        JMETER_JTL = 'reports\\performance\\jmeter.jtl'

        REPO_URL = 'https://github.com/alloci88/CP1.git'
        REPO_BRANCH = '*/master'
    }

    stages {

        stage('Get Code') {
            steps {
                logAgentInfo('Get Code')

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${REPO_BRANCH}"]],
                    userRemoteConfigs: [[url: "${REPO_URL}"]]
                ])

                prepWorkspaceVerbose()
                ensureReportsDirs()

                // Stash del código para stages posteriores (y Reto 2 con agentes).
                stash name: 'SRC',
                      includes: '**/*',
                      excludes: '.git/**,reports/**,coverage/**,**/__pycache__/**',
                      useDefaultExcludes: false
            }
        }

        /*
         * Unit: se ejecuta UNA sola vez en todo el pipeline.
         * Además, aquí generamos coverage.xml y coverage.json para usar luego sin re-ejecutar tests.
         *
         * Requisito: siempre VERDE aunque fallen tests.
         * - No fallamos el stage por exit code de pytest (capturamos returnStatus).
         * - Y el step junit no marca build unstable (skipMarkingBuildUnstable).
         */
        stage('Unit') {
            steps {
                logAgentInfo('Unit')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    int rc = bat(returnStatus: true, label: 'Pytest Unit + Coverage', script: """
                        @echo off
                        call "${PYTHON_BIN}" -m coverage run --branch -m pytest --junitxml=${UNIT_JUNIT} test\\unit
                        set EXITCODE=%ERRORLEVEL%
                        call "${PYTHON_BIN}" -m coverage xml  -o ${COVERAGE_XML}
                        call "${PYTHON_BIN}" -m coverage json -o ${COVERAGE_JSON}
                        exit /b %EXITCODE%
                    """.stripIndent())

                    echo "Unit exit code: ${rc} (stage stays green by requirement)"
                }
            }
            post {
                always {
                    // Publica tests sin marcar UNSTABLE si hay fallos (requisito: stage siempre verde).
                    junit testResults: "${UNIT_JUNIT}", allowEmptyResults: true, skipMarkingBuildUnstable: true

                    // Publica cobertura para la gráfica de Coverage plugin.
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: "${COVERAGE_XML}"]],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )

                    // Stash de reports (incluye coverage.xml/json) para Coverage stage o agentes.
                    stash name: 'REPORTS',
                          includes: 'reports/**',
                          allowEmpty: true,
                          useDefaultExcludes: false
                }
            }
        }

        /*
         * Rest (integración): igual que CP1.1.
         * Requisito: siempre VERDE aunque fallen tests.
         */
        stage('Rest') {
            steps {
                logAgentInfo('Rest')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    checkWiremockJar()

                    // Limpiar puertos por si quedaron procesos colgados
                    killByPort(env.FLASK_PORT)
                    killByPort(env.WIREMOCK_PORT)

                    startFlask()
                    startWiremock()

                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask')
                    waitHttp200("http://127.0.0.1:${env.WIREMOCK_PORT}/__admin", 10, 2, 'Healthcheck Wiremock')

                    int rc = bat(returnStatus: true, label: 'Pytest Rest', script: """
                        @echo off
                        set PYTHONPATH=.
                        "${PYTHON_BIN}" -m pytest --junitxml=${REST_JUNIT} test\\rest
                        exit /b %ERRORLEVEL%
                    """.stripIndent())

                    echo "Rest exit code: ${rc} (stage stays green by requirement)"
                }
            }
            post {
                always {
                    script {
                        killByPort(env.FLASK_PORT)
                        killByPort(env.WIREMOCK_PORT)
                    }

                    // Igual que Unit: publicar sin marcar build unstable por fallos de tests.
                    junit testResults: "${REST_JUNIT}", allowEmptyResults: true, skipMarkingBuildUnstable: true
                }
            }
        }

        /*
         * Static (flake8):
         * - Ejecutamos flake8 en formato "pylint" para Warnings-NG.
         * - Quality gates (guia):
         *   >=8  => UNSTABLE
         *   >=10 => FAILURE
         * - Pipeline debe continuar SIEMPRE (aunque quede rojo).
         *
         * Implementación:
         * - flake8 --exit-zero evita fallar el comando
         * - recordIssues + qualityGates marca estado del stage/build automáticamente
         */
        stage('Static') {
            steps {
                logAgentInfo('Static')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()
                    runFlake8Pylint()
                }
            }
            post {
                always {
                    // Parser Pylint leyendo salida de flake8 en formato pylint.
                    recordIssues(
                        enabledForFailure: true,
                        tools: [pyLint(name: 'Flake8', pattern: "${FLAKE8_REPORT}")],
                        qualityGates: [
                            // >=8 -> UNSTABLE
                            [threshold: 8, type: 'TOTAL', unstable: true],
                            // >=10 -> FAILURE
                            [threshold: 10, type: 'TOTAL', unstable: false]
                        ]
                    )

                    archiveArtifacts artifacts: "${FLAKE8_REPORT}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        /*
         * Security (bandit):
         * - Bandit genera bandit.out estilo pylint (custom + msg-template)
         * - Warnings-NG parsea con parser Pylint y aplica quality gates:
         *   >=2 -> UNSTABLE
         *   >=4 -> FAILURE
         * - Pipeline debe continuar siempre.
         */
        stage('Security') {
            steps {
                logAgentInfo('Security')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()
                    runBanditPylintStyle()
                }
            }
            post {
                always {
                    recordIssues(
                        enabledForFailure: true,
                        tools: [pyLint(name: 'Bandit', pattern: "${BANDIT_OUT}")],
                        qualityGates: [
                            // >=2 -> UNSTABLE
                            [threshold: 2, type: 'TOTAL', unstable: true],
                            // >=4 -> FAILURE
                            [threshold: 4, type: 'TOTAL', unstable: false]
                        ]
                    )

                    archiveArtifacts artifacts: "${BANDIT_OUT},${BANDIT_JSON}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        /*
         * Performance (JMeter):
         * - Flask debe estar levantado para que JMeter pueda atacar suma/resta.
         * - Ejecutamos JMeter no-GUI y publicamos con plugin Performance.
         *
         * Nota: el build puede quedar FAILURE por otras etapas (Static/Coverage),
         * pero Performance debe ejecutarse igualmente.
         */
        stage('Performance') {
            steps {
                logAgentInfo('Performance')
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    checkJmeterJar()

                    // Flask para JMeter (Wiremock no necesario para suma/resta)
                    killByPort(env.FLASK_PORT)
                    startFlask()
                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask (Perf)')

                    // Si JMeter falla, marcamos stage FAILURE, pero el pipeline sigue.
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                        runJmeter()
                    }
                }
            }
            post {
                always {
                    script {
                        killByPort(env.FLASK_PORT)
                    }

                    // Publica JTL en plugin Performance (gráficas, percentiles, etc.)
                    perfReport(
                        sourceDataFiles: "${JMETER_JTL}",
                        errorUnstableThreshold: 1,
                        errorFailedThreshold: 5,
                        percentiles: '0,50,90,95,100'
                    )

                    archiveArtifacts artifacts: "${JMETER_JTL}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        /*
         * Coverage:
         * - NO se vuelven a ejecutar unit tests (requisito).
         * - Leemos coverage.json generado en Unit.
         * - Aplicamos umbrales guía:
         *   Lines: 85..95 UNSTABLE, >95 GREEN, <85 FAILURE
         *   Branches: 80..90 UNSTABLE, >90 GREEN, <80 FAILURE
         * - Pipeline debe continuar siempre.
         */
        stage('Coverage') {
            steps {
                logAgentInfo('Coverage')
                script {
                    deleteDir()

                    // Solo necesitamos los reports generados en Unit (coverage.json)
                    unstash 'REPORTS'
                    ensureReportsDirs()

                    def (double linesPct, double branchesPct) = readCoveragePercents()
                    echo "Coverage lines: ${linesPct}%"
                    echo "Coverage branches: ${branchesPct}%"

                    boolean linesUnstable = (linesPct >= 85.0 && linesPct <= 95.0)
                    boolean linesFail = (linesPct < 85.0)

                    boolean branchesUnstable = (branchesPct >= 80.0 && branchesPct <= 90.0)
                    boolean branchesFail = (branchesPct < 80.0)

                    if (linesFail || branchesFail) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            error("Coverage unhealthy (lines=${linesPct}%, branches=${branchesPct}%)")
                        }
                        setBuildResultWorst('FAILURE')
                    } else if (linesUnstable || branchesUnstable) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            error("Coverage unstable (lines=${linesPct}%, branches=${branchesPct}%)")
                        }
                        setBuildResultWorst('UNSTABLE')
                    } else {
                        echo "Coverage OK"
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${COVERAGE_XML},${COVERAGE_JSON}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            // Limpieza final del workspace (buena práctica + Reto 2)
            cleanWs(deleteDirs: true)
        }
    }
}