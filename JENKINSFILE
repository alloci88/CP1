/*
 * =========================
 * Funciones auxiliares
 * =========================
 * 
 * Estas funciones encapsulan lógica repetitiva para:
 *  - Evitar bloques bat gigantes y difíciles de mantener
 *  - Reducir duplicación
 *  - Hacer el Jenkinsfile más legible y evaluable
 *
 * Todo sigue estando dentro del Jenkinsfile (requisito del enunciado)
 */

/**
 * Ejecuta un comando batch con una etiqueta clara en el log de Jenkins
 */
def runBat(String label, String script) {
    bat(label: label, script: script)
}

/**
 * Verificaciones iniciales del workspace:
 *  - Información del entorno
 *  - Creación del directorio de reports
 *  - Verificación de Python
 *  - Verificación del JAR de Wiremock
 */
def prepWorkspace() {
    runBat('Workspace / Tools', """
        @echo off
        echo === Workspace info ===
        dir
        whoami
        hostname
        echo %WORKSPACE%

        if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%"

        echo === Python ===
        "%PYTHON_BIN%" --version

        echo === Wiremock jar ===
        if exist "%WIREMOCK_JAR%" (echo Wiremock OK) else (echo Wiremock NO EXISTE & exit /b 1)

        exit /b 0
    """.stripIndent())
}

/**
 * Mata procesos que estén escuchando en un puerto concreto.
 * Es idempotente: si no hay procesos, no falla.
 */
def killByPort(String port) {
    runBat("Stop processes on ${port}", """
        @echo off
        for /F "tokens=5" %%a in ('netstat -ano ^| findstr :${port} ^| findstr LISTENING') do (
            taskkill /F /PID %%a 1>nul 2>nul
            if errorlevel 1 (echo PID %%a on ${port} already dead) else (echo Killed PID %%a on ${port})
        )
        exit /b 0
    """.stripIndent())
}

/**
 * Espera a que una URL devuelva HTTP 200.
 * Se usa como healthcheck antes de lanzar los tests REST.
 */
def waitHttp200(String url, int maxTries, int timeoutSec, String label) {
    runBat(label, """
        @echo off
        for /L %%i in (1,1,${maxTries}) do (
            powershell -NoProfile -Command "try { (Invoke-WebRequest -UseBasicParsing '${url}' -TimeoutSec ${timeoutSec}).StatusCode } catch { 0 }" ^
                | findstr /R "^200$" >nul && exit /b 0
            ping -n 2 127.0.0.1 >nul
        )
        exit /b 1
    """.stripIndent())
}

/**
 * Arranca la aplicación Flask en segundo plano
 */
def startFlask() {
    runBat('Start Flask', """
        @echo off
        set PYTHONPATH=.
        set FLASK_APP=app\\api.py
        start "" /B "%PYTHON_BIN%" -m flask run --host 127.0.0.1 --port %FLASK_PORT% --no-reload
        exit /b 0
    """.stripIndent())
}

/**
 * Arranca Wiremock en segundo plano
 */
def startWiremock() {
    runBat('Start Wiremock', """
        @echo off
        start "" /B java -jar "%WIREMOCK_JAR%" --port %WIREMOCK_PORT% --root-dir test\\wiremock
        exit /b 0
    """.stripIndent())
}

/**
 * Ejecuta los tests unitarios y genera reporte JUnit
 */
def runUnitTests() {
    runBat('Pytest Unit', """
        @echo off
        set PYTHONPATH=.
        "%PYTHON_BIN%" -m pytest --junitxml=%UNIT_JUNIT% test\\unit
        exit /b %ERRORLEVEL%
    """.stripIndent())
}

/**
 * Ejecuta los tests REST y genera reporte JUnit
 */
def runRestTests() {
    runBat('Pytest Rest', """
        @echo off
        set PYTHONPATH=.
        "%PYTHON_BIN%" -m pytest --junitxml=%REST_JUNIT% test\\rest
        exit /b %ERRORLEVEL%
    """.stripIndent())
}

/*
 * =========================
 * Pipeline Declarativo
 * =========================
 */

pipeline {
    agent any

    /*
     * Opciones globales del pipeline
     * - timestamps: añade marcas de tiempo a los logs
     * - skipDefaultCheckout: evitamos el checkout implícito
     *   porque controlamos nosotros el Git explícitamente
     */
    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    /*
     * Variables de entorno comunes a todo el pipeline
     */
    environment {
        PYTHON_BIN = 'C:\\ci\\venvs\\cp1\\Scripts\\python.exe'

        REPORTS_DIR = 'reports'
        UNIT_JUNIT = 'reports\\result-unit.xml'
        REST_JUNIT = 'reports\\result-rest.xml'

        FLASK_PORT = '5000'
        WIREMOCK_PORT = '9090'

        WIREMOCK_JAR = 'C:\\ci\\tools\\wiremock-standalone-3.13.2.jar'

        REPO_URL = 'https://github.com/alloci88/CP1.git'
        REPO_BRANCH = '*/master'
        GIT_TOOL = 'Default'
    }

    stages {

        /*
         * =========================
         * Stage: Get Code
         * =========================
         * - Checkout explícito del repositorio
         * - Preparación del workspace
         */
        stage('Get Code') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${REPO_BRANCH}"]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    userRemoteConfigs: [[url: "${REPO_URL}"]],
                    gitTool: "${GIT_TOOL}"
                ])

                prepWorkspace()
            }
        }

        /*
         * =========================
         * Stage: Unit
         * =========================
         * - Ejecuta tests unitarios
         * - Si fallan, el stage falla pero el pipeline continúa
         */
        stage('Unit') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    runUnitTests()
                }
            }
            post {
                always {
                    junit testResults: "${UNIT_JUNIT}", allowEmptyResults: true
                }
            }
        }

        /*
         * =========================
         * Stage: Rest
         * =========================
         * - Limpia posibles procesos previos
         * - Arranca Flask y Wiremock
         * - Espera a que estén operativos
         * - Ejecuta tests REST
         * - Limpia procesos SIEMPRE al final
         */
        stage('Rest') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {

                    // Limpieza preventiva
                    killByPort(env.FLASK_PORT)
                    killByPort(env.WIREMOCK_PORT)

                    // Arranque de servicios
                    startFlask()
                    startWiremock()

                    // Healthchecks
                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask')
                    waitHttp200("http://127.0.0.1:${env.WIREMOCK_PORT}/__admin", 10, 2, 'Healthcheck Wiremock')

                    // Tests REST
                    runRestTests()
                }
            }
            post {
                always {
                    // Limpieza garantizada incluso si fallan tests
                    script {
                        killByPort(env.FLASK_PORT)
                        killByPort(env.WIREMOCK_PORT)
                    }
                    junit testResults: "${REST_JUNIT}", allowEmptyResults: true
                }
            }
        }
    }
}


