/*
 * =========================
 * Helper functions
 * =========================
 * NOTE: ASCII only to avoid encoding issues in Jenkins on Windows.
 */

def runBat(String label, String script) {
    bat(label: label, script: script)
}

/*
 * Minimal per-stage prep: only ensure report folders exist.
 */
def ensureReportsDirs() {
    runBat('Ensure reports dirs', """
        @echo off
        if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%"
        if not exist "%REPORTS_UNIT_DIR%" mkdir "%REPORTS_UNIT_DIR%"
        if not exist "%REPORTS_REST_DIR%" mkdir "%REPORTS_REST_DIR%"
        if not exist "%REPORTS_STATIC_DIR%" mkdir "%REPORTS_STATIC_DIR%"
        if not exist "%REPORTS_SECURITY_DIR%" mkdir "%REPORTS_SECURITY_DIR%"
        if not exist "%REPORTS_COVERAGE_DIR%" mkdir "%REPORTS_COVERAGE_DIR%"
        if not exist "%REPORTS_PERFORMANCE_DIR%" mkdir "%REPORTS_PERFORMANCE_DIR%"
        exit /b 0
    """.stripIndent())
}

/*
 * Verbose info only once (required by enunciado).
 */
def prepWorkspaceVerbose() {
    runBat('Workspace info (verbose)', """
        @echo off
        echo === Workspace info ===
        whoami
        hostname
        echo %WORKSPACE%
        echo === Python ===
        "%PYTHON_BIN%" --version
        exit /b 0
    """.stripIndent())
}

def checkWiremockJar() {
    runBat('Check Wiremock jar', """
        @echo off
        if exist "%WIREMOCK_JAR%" (echo Wiremock OK) else (echo Wiremock MISSING & exit /b 1)
        exit /b 0
    """.stripIndent())
}

def checkJmeterJar() {
    runBat('Check JMeter', """
        @echo off
        if exist "%JMETER_JAR%" (echo JMeter OK) else (echo JMeter MISSING & exit /b 1)
        exit /b 0
    """.stripIndent())
}

def killByPort(String port) {
    runBat("Stop processes on ${port}", """
        @echo off
        for /f "tokens=5" %%p in ('netstat -ano ^| findstr /R /C:":${port} .*LISTENING"') do (
            taskkill /F /PID %%p 1>nul 2>nul
        )
        exit /b 0
    """.stripIndent())
}

/*
 * IMPORTANT: avoid Groovy "$" interpolation issues inside bat strings.
 * We build the script with .replace(...) and keep "^200$" literal.
 */
def waitHttp200(String url, int maxTries, int timeoutSec, String label) {
    runBat(label,
        '''
        @echo off
        for /L %%i in (1,1,%MAX_TRIES%) do (
            powershell -NoProfile -Command "try { (Invoke-WebRequest -UseBasicParsing '%URL%' -TimeoutSec %TIMEOUT%).StatusCode } catch { 0 }" ^
                | findstr "^200$" >nul && exit /b 0
            ping -n 2 127.0.0.1 >nul
        )
        exit /b 1
        '''
        .replace('%URL%', url)
        .replace('%MAX_TRIES%', maxTries.toString())
        .replace('%TIMEOUT%', timeoutSec.toString())
        .stripIndent()
    )
}

def startFlask() {
    runBat('Start Flask', """
        @echo off
        set PYTHONPATH=.
        set FLASK_APP=app\\api.py
        start "" /B "%PYTHON_BIN%" -m flask run --host 127.0.0.1 --port %FLASK_PORT% --no-reload
        exit /b 0
    """.stripIndent())
}

def startWiremock() {
    runBat('Start Wiremock', """
        @echo off
        start "" /B java -jar "%WIREMOCK_JAR%" --port %WIREMOCK_PORT% --root-dir test\\wiremock
        exit /b 0
    """.stripIndent())
}

def runFlake8() {
    runBat('Flake8', """
        @echo off
        set PYTHONPATH=.
        rem flake8 returns non-zero when issues exist; do NOT fail here
        "%PYTHON_BIN%" -m flake8 app test --format=default > "%FLAKE8_REPORT%"
        exit /b 0
    """.stripIndent())
}

def runBandit() {
    runBat('Bandit', """
        @echo off
        set PYTHONPATH=.
        rem bandit may return non-zero when issues exist; do NOT fail here
        "%PYTHON_BIN%" -m bandit -r app -f json -o "%BANDIT_JSON%"
        "%PYTHON_BIN%" -m bandit -r app -f txt  -o "%BANDIT_REPORT%"
        exit /b 0
    """.stripIndent())
}

def runJmeter() {
    runBat('JMeter', """
        @echo off
        if exist "%JMETER_JTL%" del /q "%JMETER_JTL%" 1>nul 2>nul
        java -jar "%JMETER_JAR%" -n -t "%JMETER_TESTPLAN%" -l "%JMETER_JTL%"
        exit /b %ERRORLEVEL%
    """.stripIndent())
}

/*
 * Build result escalator (SUCCESS < UNSTABLE < FAILURE)
 */
def setBuildResultWorst(String target) {
    String current = (currentBuild.result ?: 'SUCCESS')
    Map<String, Integer> rank = ['SUCCESS': 0, 'UNSTABLE': 1, 'FAILURE': 2]
    int curRank = rank.containsKey(current) ? rank[current] : 0
    int tgtRank = rank.containsKey(target) ? rank[target] : 0

    if (tgtRank > curRank) {
        currentBuild.result = target
        echo "Build result escalated: ${current} -> ${target}"
    } else {
        echo "Build result unchanged: ${current} (requested ${target})"
    }
}

def countFlake8Findings() {
    return bat(
        label: 'Count Flake8 findings',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%FLAKE8_REPORT%" (echo 0 & exit /b 0)
            for /f %%a in ('find /v /c "" ^< "%FLAKE8_REPORT%"') do @echo %%a
            exit /b 0
        """.stripIndent()
    ).trim()
}

def countBanditFindings() {
    return bat(
        label: 'Count Bandit findings (JSON)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%BANDIT_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; d=json.load(open(r'%BANDIT_JSON%')); print(len(d.get('results',[])))"
            exit /b 0
        """.stripIndent()
    ).trim()
}

/*
 * Coverage read (NO re-running unit tests allowed).
 * Reads totals from coverage.json created in Unit stage.
 */
def readCoveragePercents() {
    String outLines = bat(
        label: 'Read coverage percent (lines)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; d=json.load(open(r'%COVERAGE_JSON%')); t=d.get('totals',{}); print(f\\\"{t.get('percent_covered',0):.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    String outBranches = bat(
        label: 'Read coverage percent (branches)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; d=json.load(open(r'%COVERAGE_JSON%')); t=d.get('totals',{}); cb=t.get('covered_branches',0); nb=t.get('num_branches',0); pct=(cb*100.0/nb) if nb else 0.0; print(f\\\"{pct:.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    double linesPct = outLines ? outLines.toDouble() : 0.0
    double branchesPct = outBranches ? outBranches.toDouble() : 0.0
    return [linesPct, branchesPct]
}

/*
 * Bandit JSON -> SARIF (so warnings-ng can chart "Security")
 */
def banditJsonToSarif() {
    writeFile(
        file: 'reports\\security\\bandit_to_sarif.py',
        text: '''
import json
import os
from pathlib import Path

bandit_json = Path(os.environ.get("BANDIT_JSON", "reports\\\\security\\\\bandit.json"))
sarif_path  = Path(os.environ.get("BANDIT_SARIF", "reports\\\\security\\\\bandit.sarif"))

def write_empty():
    sarif = {
        "version": "2.1.0",
        "runs": [{
            "tool": {"driver": {"name": "bandit", "informationUri": "https://bandit.readthedocs.io", "rules": []}},
            "results": []
        }]
    }
    sarif_path.parent.mkdir(parents=True, exist_ok=True)
    sarif_path.write_text(json.dumps(sarif, ensure_ascii=False), encoding="utf-8")

if not bandit_json.exists():
    write_empty()
    raise SystemExit(0)

data = json.loads(bandit_json.read_text(encoding="utf-8"))
results_in = data.get("results", []) or []

rules = {}
results = []

for r in results_in:
    rid = str(r.get("test_id") or "BANDIT")
    text = str(r.get("issue_text") or "Bandit issue")
    file_name = str(r.get("filename") or "unknown")
    line = int(r.get("line_number") or 1)

    sev = str(r.get("issue_severity") or "MEDIUM").upper()
    level = "warning"
    if sev == "HIGH":
        level = "error"
    elif sev == "LOW":
        level = "note"

    rules.setdefault(rid, {"id": rid, "name": rid, "shortDescription": {"text": text}})

    results.append({
        "ruleId": rid,
        "level": level,
        "message": {"text": f"{rid}: {text}"},
        "locations": [{
            "physicalLocation": {
                "artifactLocation": {"uri": file_name},
                "region": {"startLine": line}
            }
        }]
    })

sarif = {
    "version": "2.1.0",
    "runs": [{
        "tool": {"driver": {"name": "bandit", "informationUri": "https://bandit.readthedocs.io", "rules": list(rules.values())}},
        "results": results
    }]
}

sarif_path.parent.mkdir(parents=True, exist_ok=True)
sarif_path.write_text(json.dumps(sarif, ensure_ascii=False), encoding="utf-8")
'''.stripIndent()
    )

    int rc = bat(returnStatus: true, label: 'Convert Bandit JSON -> SARIF', script: """
        @echo off
        "%PYTHON_BIN%" "reports\\security\\bandit_to_sarif.py"
        exit /b %ERRORLEVEL%
    """.stripIndent())

    echo "Bandit SARIF converter exit code: ${rc}"
    return rc
}

def ensureBanditSarifExists() {
    if (!fileExists(env.BANDIT_SARIF)) {
        writeFile(
            file: env.BANDIT_SARIF,
            text: '{"version":"2.1.0","runs":[{"tool":{"driver":{"name":"bandit","informationUri":"https://bandit.readthedocs.io","rules":[]}},"results":[]}]}'
        )
        echo "Bandit SARIF missing; created minimal fallback at ${env.BANDIT_SARIF}"
    }
}

pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    environment {
        PYTHON_BIN = 'C:\\ci\\venvs\\cp1\\Scripts\\python.exe'

        REPORTS_DIR = 'reports'
        REPORTS_UNIT_DIR = 'reports\\unit'
        REPORTS_REST_DIR = 'reports\\rest'
        REPORTS_STATIC_DIR = 'reports\\static'
        REPORTS_SECURITY_DIR = 'reports\\security'
        REPORTS_COVERAGE_DIR = 'reports\\coverage'
        REPORTS_PERFORMANCE_DIR = 'reports\\performance'

        UNIT_JUNIT = 'reports\\unit\\result-unit.xml'
        REST_JUNIT = 'reports\\rest\\result-rest.xml'
        COVERAGE_XML = 'reports\\coverage\\coverage.xml'
        COVERAGE_JSON = 'reports\\coverage\\coverage.json'

        FLAKE8_REPORT = 'reports\\static\\flake8.txt'

        BANDIT_JSON = 'reports\\security\\bandit.json'
        BANDIT_REPORT = 'reports\\security\\bandit.txt'
        BANDIT_SARIF = 'reports\\security\\bandit.sarif'

        FLASK_PORT = '5000'
        WIREMOCK_PORT = '9090'

        WIREMOCK_JAR = 'C:\\ci\\tools\\wiremock-standalone-3.13.2.jar'

        JMETER_JAR = 'C:\\ci\\tools\\apache-jmeter-5.6.3\\bin\\ApacheJMeter.jar'
        JMETER_TESTPLAN = 'test\\jmeter\\flask.jmx'
        JMETER_JTL = 'reports\\performance\\jmeter.jtl'

        REPO_URL = 'https://github.com/alloci88/CP1.git'
        REPO_BRANCH = '*/master'
    }

    stages {

        stage('Get Code') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${REPO_BRANCH}"]],
                    userRemoteConfigs: [[url: "${REPO_URL}"]]
                ])

                prepWorkspaceVerbose()
                ensureReportsDirs()

                stash name: 'SRC',
                      includes: '**/*',
                      excludes: '.git/**,reports/**,coverage/**,**/__pycache__/**',
                      useDefaultExcludes: false
            }
        }

        /*
         * Unit must be GREEN always (even if tests fail), and run only once.
         */
        stage('Unit') {
            steps {
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    int rc = bat(returnStatus: true, label: 'Pytest Unit + Coverage', script: """
                        @echo off
                        call "${PYTHON_BIN}" -m coverage run --branch -m pytest --junitxml=${UNIT_JUNIT} test\\unit
                        set EXITCODE=%ERRORLEVEL%
                        call "${PYTHON_BIN}" -m coverage xml -o ${COVERAGE_XML}
                        call "${PYTHON_BIN}" -m coverage json -o ${COVERAGE_JSON}
                        exit /b %EXITCODE%
                    """.stripIndent())

                    echo "Unit exit code: ${rc} (stage stays green by requirement)"
                }
            }
            post {
                always {
                    junit testResults: "${UNIT_JUNIT}", allowEmptyResults: true

                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: "${COVERAGE_XML}"]],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )

                    stash name: 'REPORTS', includes: 'reports/**', allowEmpty: true, useDefaultExcludes: false
                }
            }
        }

        /*
         * Rest must be GREEN always (even if tests fail).
         */
        stage('Rest') {
            steps {
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    checkWiremockJar()
                    killByPort(env.FLASK_PORT)
                    killByPort(env.WIREMOCK_PORT)

                    startFlask()
                    startWiremock()

                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask')
                    waitHttp200("http://127.0.0.1:${env.WIREMOCK_PORT}/__admin", 10, 2, 'Healthcheck Wiremock')

                    int rc = bat(returnStatus: true, label: 'Pytest Rest', script: """
                        @echo off
                        set PYTHONPATH=.
                        "${PYTHON_BIN}" -m pytest --junitxml=${REST_JUNIT} test\\rest
                        exit /b %ERRORLEVEL%
                    """.stripIndent())

                    echo "Rest exit code: ${rc} (stage stays green by requirement)"
                }
            }
            post {
                always {
                    script {
                        killByPort(env.FLASK_PORT)
                        killByPort(env.WIREMOCK_PORT)
                    }
                    junit testResults: "${REST_JUNIT}", allowEmptyResults: true
                }
            }
        }

        /*
         * Static (flake8) gates:
         * - >= 8  => UNSTABLE (yellow)
         * - >= 10 => FAILURE (red)
         * Pipeline must continue.
         */
        stage('Static') {
            steps {
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    runFlake8()
                    int findings = countFlake8Findings().toInteger()
                    echo "Flake8 findings: ${findings}"

                    if (findings >= 10) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            error("Flake8 unhealthy: ${findings} >= 10")
                        }
                        setBuildResultWorst('FAILURE')
                    } else if (findings >= 8) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            error("Flake8 unstable: ${findings} >= 8")
                        }
                        setBuildResultWorst('UNSTABLE')
                    } else {
                        echo "Flake8 OK (<8)"
                    }
                }
            }
            post {
                always {
                    recordIssues(tools: [flake8(pattern: "${FLAKE8_REPORT}")], enabledForFailure: true)
                    archiveArtifacts artifacts: "${FLAKE8_REPORT}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        /*
         * Security (bandit) gates:
         * - >= 2  => UNSTABLE (yellow)
         * - >= 4  => FAILURE (red)
         * Pipeline must continue.
         */
        stage('Security') {
            steps {
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    runBandit()
                    int findings = countBanditFindings().toInteger()
                    echo "Bandit findings: ${findings}"

                    if (findings >= 4) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            error("Bandit unhealthy: ${findings} >= 4")
                        }
                        setBuildResultWorst('FAILURE')
                    } else if (findings >= 2) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            error("Bandit unstable: ${findings} >= 2")
                        }
                        setBuildResultWorst('UNSTABLE')
                    } else {
                        echo "Bandit OK (<2)"
                    }
                }
            }
            post {
                always {
                    script {
                        int rc = banditJsonToSarif()
                        ensureBanditSarifExists()
                        echo "Bandit SARIF publish completed (converter rc=${rc})"
                    }
                    recordIssues(tools: [sarif(pattern: "${BANDIT_SARIF}")], enabledForFailure: true)
                    archiveArtifacts artifacts: "${BANDIT_JSON},${BANDIT_REPORT},${BANDIT_SARIF}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        /*
         * Performance (JMeter):
         * - flask must be up
         * - run test plan and publish via perfReport
         * (Coloring is driven by perfReport thresholds; enunciado doesn't define extra gates.)
         */
        stage('Performance') {
            steps {
                script {
                    deleteDir()
                    unstash 'SRC'
                    ensureReportsDirs()

                    checkJmeterJar()
                    killByPort(env.FLASK_PORT)
                    startFlask()
                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask (Perf)')

                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                        runJmeter()
                    }
                }
            }
            post {
                always {
                    script { killByPort(env.FLASK_PORT) }

                    perfReport(
                        sourceDataFiles: "${JMETER_JTL}",
                        errorUnstableThreshold: 1,
                        errorFailedThreshold: 5,
                        percentiles: '0,50,90,95,100'
                    )

                    archiveArtifacts artifacts: "${JMETER_JTL}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        /*
         * Coverage gates (NO rerun of unit tests allowed):
         * Lines:
         * - 85..95 => UNSTABLE
         * - >95    => GREEN
         * - <85    => FAILURE
         * Branches:
         * - 80..90 => UNSTABLE
         * - >90    => GREEN
         * - <80    => FAILURE
         * Pipeline must continue.
         */
        stage('Coverage') {
            steps {
                script {
                    deleteDir()
                    unstash 'REPORTS'
                    ensureReportsDirs()

                    def (double linesPct, double branchesPct) = readCoveragePercents()
                    echo "Coverage lines: ${linesPct}%"
                    echo "Coverage branches: ${branchesPct}%"

                    boolean linesUnstable = (linesPct >= 85.0 && linesPct <= 95.0)
                    boolean linesFail = (linesPct < 85.0)

                    boolean branchesUnstable = (branchesPct >= 80.0 && branchesPct <= 90.0)
                    boolean branchesFail = (branchesPct < 80.0)

                    if (linesFail || branchesFail) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            error("Coverage unhealthy (lines=${linesPct}%, branches=${branchesPct}%)")
                        }
                        setBuildResultWorst('FAILURE')
                    } else if (linesUnstable || branchesUnstable) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            error("Coverage unstable (lines=${linesPct}%, branches=${branchesPct}%)")
                        }
                        setBuildResultWorst('UNSTABLE')
                    } else {
                        echo "Coverage OK"
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${COVERAGE_XML},${COVERAGE_JSON}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true)
        }
    }
}