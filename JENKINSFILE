/*
 * =========================
 * Helper functions
 * =========================
 * NOTE: ASCII only to avoid encoding issues in Jenkins on Windows.
 */

def runBat(String label, String script) {
    bat(label: label, script: script)
}

def prepWorkspace() {
    runBat('Workspace / Tools v2', """
        @echo off
        echo === Workspace info ===
        dir
        whoami
        hostname
        echo %WORKSPACE%

        if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%"
        if not exist "%REPORTS_UNIT_DIR%" mkdir "%REPORTS_UNIT_DIR%"
        if not exist "%REPORTS_REST_DIR%" mkdir "%REPORTS_REST_DIR%"
        if not exist "%REPORTS_STATIC_DIR%" mkdir "%REPORTS_STATIC_DIR%"
        if not exist "%REPORTS_SECURITY_DIR%" mkdir "%REPORTS_SECURITY_DIR%"
        if not exist "%REPORTS_COVERAGE_DIR%" mkdir "%REPORTS_COVERAGE_DIR%"
        if not exist "%REPORTS_PERFORMANCE_DIR%" mkdir "%REPORTS_PERFORMANCE_DIR%"

        echo === Python ===
        "%PYTHON_BIN%" --version

        echo === Wiremock jar ===
        if exist "%WIREMOCK_JAR%" (echo Wiremock OK) else (echo Wiremock MISSING & exit /b 1)

        echo === JMeter ===
        if exist "%JMETER_JAR%" (echo JMeter OK) else (echo JMeter MISSING & exit /b 1)

        exit /b 0
    """.stripIndent())
}

def killByPort(String port) {
    runBat("Stop processes on ${port}", """
        @echo off
        for /F "tokens=5" %%a in ('netstat -ano ^| findstr :${port} ^| findstr LISTENING') do (
            taskkill /F /PID %%a 1>nul 2>nul
            if errorlevel 1 (echo PID %%a on ${port} already dead) else (echo Killed PID %%a on ${port})
        )
        exit /b 0
    """.stripIndent())
}

def waitHttp200(String url, int maxTries, int timeoutSec, String label) {
    runBat(label, """
        @echo off
        for /L %%i in (1,1,${maxTries}) do (
            powershell -NoProfile -Command "try { (Invoke-WebRequest -UseBasicParsing '${url}' -TimeoutSec ${timeoutSec}).StatusCode } catch { 0 }" ^
                | findstr /R "^200\$" >nul && exit /b 0
            ping -n 2 127.0.0.1 >nul
        )
        exit /b 1
    """.stripIndent())
}

def startFlask() {
    runBat('Start Flask', """
        @echo off
        set PYTHONPATH=.
        set FLASK_APP=app\\api.py
        start "" /B "%PYTHON_BIN%" -m flask run --host 127.0.0.1 --port %FLASK_PORT% --no-reload
        exit /b 0
    """.stripIndent())
}

def startWiremock() {
    runBat('Start Wiremock', """
        @echo off
        start "" /B java -jar "%WIREMOCK_JAR%" --port %WIREMOCK_PORT% --root-dir test\\wiremock
        exit /b 0
    """.stripIndent())
}

/*
 * Flake8 -> report parseable by Warnings-NG flake8()
 */
def runFlake8() {
    runBat('Flake8', """
        @echo off
        set PYTHONPATH=.
        rem flake8 returns non-zero when issues exist, do NOT fail here
        "%PYTHON_BIN%" -m flake8 app test --format=default > "%FLAKE8_REPORT%"
        exit /b 0
    """.stripIndent())
}

def runBandit() {
    runBat('Bandit (JSON+TXT)', """
        @echo off
        set PYTHONPATH=.
        rem Bandit returns exit code != 0 if issues exist; do NOT fail here
        "%PYTHON_BIN%" -m bandit -r app -f json -o "%BANDIT_JSON%"
        "%PYTHON_BIN%" -m bandit -r app -f txt  -o "%BANDIT_REPORT%"
        exit /b 0
    """.stripIndent())
}

/*
 * Convert Bandit JSON to SARIF.
 * We avoid cmd heredocs ("<<") because Windows cmd doesn't support them.
 * We also avoid "$schema" (SARIF field) to prevent Groovy GString "$" interpolation pitfalls.
 */
def banditJsonToSarif() {
    writeFile(
        file: 'reports\\security\\bandit_to_sarif.py',
        text: '''
import json
from pathlib import Path

bandit_json = Path(r"%BANDIT_JSON%")
sarif_path = Path(r"%BANDIT_SARIF%")

def write_empty():
    sarif = {
        "version": "2.1.0",
        "runs": [{
            "tool": {
                "driver": {
                    "name": "bandit",
                    "informationUri": "https://bandit.readthedocs.io",
                    "rules": []
                }
            },
            "results": []
        }]
    }
    sarif_path.parent.mkdir(parents=True, exist_ok=True)
    sarif_path.write_text(json.dumps(sarif, ensure_ascii=False), encoding="utf-8")

if not bandit_json.exists():
    write_empty()
    raise SystemExit(0)

data = json.loads(bandit_json.read_text(encoding="utf-8"))
results_in = data.get("results", []) or []

rules = {}
results = []

for r in results_in:
    rid = str(r.get("test_id") or "BANDIT")
    text = str(r.get("issue_text") or "Bandit issue")
    file_name = str(r.get("filename") or "unknown")
    line = int(r.get("line_number") or 1)

    sev = str(r.get("issue_severity") or "MEDIUM").upper()
    level = "warning"
    if sev == "HIGH":
        level = "error"
    elif sev == "LOW":
        level = "note"

    rules.setdefault(rid, {
        "id": rid,
        "name": rid,
        "shortDescription": {"text": text}
    })

    results.append({
        "ruleId": rid,
        "level": level,
        "message": {"text": f"{rid}: {text}"},
        "locations": [{
            "physicalLocation": {
                "artifactLocation": {"uri": file_name},
                "region": {"startLine": line}
            }
        }]
    })

sarif = {
    "version": "2.1.0",
    "runs": [{
        "tool": {
            "driver": {
                "name": "bandit",
                "informationUri": "https://bandit.readthedocs.io",
                "rules": list(rules.values())
            }
        },
        "results": results
    }]
}

sarif_path.parent.mkdir(parents=True, exist_ok=True)
sarif_path.write_text(json.dumps(sarif, ensure_ascii=False), encoding="utf-8")
'''.stripIndent()
    )

    runBat('Convert Bandit JSON -> SARIF', """
        @echo off
        "%PYTHON_BIN%" "reports\\security\\bandit_to_sarif.py"
        exit /b 0
    """.stripIndent())
}

def countFlake8Findings() {
    return bat(
        label: 'Count Flake8 findings',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%FLAKE8_REPORT%" (echo 0 & exit /b 0)
            for /f %%a in ('type "%FLAKE8_REPORT%" ^| find /c ":"') do @echo %%a
            exit /b 0
        """.stripIndent()
    ).trim()
}

def countBanditFindings() {
    return bat(
        label: 'Count Bandit findings (JSON)',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%BANDIT_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; d=json.load(open(r'%BANDIT_JSON%')); print(len(d.get('results',[])))"
            exit /b 0
        """.stripIndent()
    ).trim()
}

def readCoveragePercents() {
    String out = bat(
        label: 'Read coverage percents',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo LINES=0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; d=json.load(open(r'%COVERAGE_JSON%')); t=d.get('totals',{}); print(f\\\"LINES={t.get('percent_covered',0):.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    String out2 = bat(
        label: 'Read branch coverage percent',
        returnStdout: true,
        script: """
            @echo off
            if not exist "%COVERAGE_JSON%" (echo 0 & exit /b 0)
            "%PYTHON_BIN%" -c "import json; d=json.load(open(r'%COVERAGE_JSON%')); t=d.get('totals',{}); cb=t.get('covered_branches',0); nb=t.get('num_branches',0); pct=(cb*100.0/nb) if nb else 0.0; print(f\\\"{pct:.2f}\\\")"
            exit /b 0
        """.stripIndent()
    ).trim()

    def m = (out =~ /LINES=([0-9.]+)/)
    double linesPct = m ? m[0][1].toDouble() : 0.0
    double branchesPct = out2 ? out2.toDouble() : 0.0

    return [linesPct, branchesPct]
}

/*
 * JMeter: call Java directly to avoid brittle/corrupt .bat behavior on some installs.
 */
def runJmeter() {
    runBat('JMeter', """
        @echo off
        if exist "%JMETER_JTL%" del /q "%JMETER_JTL%" 1>nul 2>nul

        java -jar "%JMETER_JAR%" -n -t "%JMETER_TESTPLAN%" -l "%JMETER_JTL%"
        set RC=%ERRORLEVEL%

        echo JMETER_RC=%RC%
        exit /b %RC%
    """.stripIndent())
}

pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    environment {
        PYTHON_BIN = 'C:\\ci\\venvs\\cp1\\Scripts\\python.exe'

        REPORTS_DIR = 'reports'
        REPORTS_UNIT_DIR = 'reports\\unit'
        REPORTS_REST_DIR = 'reports\\rest'
        REPORTS_STATIC_DIR = 'reports\\static'
        REPORTS_SECURITY_DIR = 'reports\\security'
        REPORTS_COVERAGE_DIR = 'reports\\coverage'
        REPORTS_PERFORMANCE_DIR = 'reports\\performance'

        UNIT_JUNIT = 'reports\\unit\\result-unit.xml'
        REST_JUNIT = 'reports\\rest\\result-rest.xml'

        COVERAGE_XML = 'reports\\coverage\\coverage.xml'
        COVERAGE_JSON = 'reports\\coverage\\coverage.json'

        FLAKE8_REPORT = 'reports\\static\\flake8.txt'

        BANDIT_JSON = 'reports\\security\\bandit.json'
        BANDIT_REPORT = 'reports\\security\\bandit.txt'
        BANDIT_SARIF = 'reports\\security\\bandit.sarif'

        FLASK_PORT = '5000'
        WIREMOCK_PORT = '9090'

        WIREMOCK_JAR = 'C:\\ci\\tools\\wiremock-standalone-3.13.2.jar'

        JMETER_JAR = 'C:\\ci\\tools\\apache-jmeter-5.6.3\\bin\\ApacheJMeter.jar'
        JMETER_TESTPLAN = 'test\\jmeter\\flask.jmx'
        JMETER_JTL = 'reports\\performance\\jmeter.jtl'

        REPO_URL = 'https://github.com/alloci88/CP1.git'
        REPO_BRANCH = '*/master'
        GIT_TOOL = 'Default'
    }

    stages {

        stage('Get Code') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${REPO_BRANCH}"]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [],
                    userRemoteConfigs: [[url: "${REPO_URL}"]],
                    gitTool: "${GIT_TOOL}"
                ])
                prepWorkspace()
            }
        }

        stage('Unit') {
            steps {
                script {
                    int rc = bat(returnStatus: true, label: 'Pytest Unit + Coverage', script: """
                        @echo off
                        call "${PYTHON_BIN}" -m coverage run --branch -m pytest --junitxml=${UNIT_JUNIT} test\\unit
                        set EXITCODE=%ERRORLEVEL%
                        call "${PYTHON_BIN}" -m coverage xml -o ${COVERAGE_XML}
                        call "${PYTHON_BIN}" -m coverage json -o ${COVERAGE_JSON}
                        exit /b %EXITCODE%
                    """.stripIndent())
                    echo "Unit exit code: ${rc} (stage stays green by requirement)"
                }
            }
            post {
                always {
                    junit testResults: "${UNIT_JUNIT}", allowEmptyResults: true
                }
            }
        }

        stage('Rest') {
            steps {
                script {
                    killByPort(env.FLASK_PORT)
                    killByPort(env.WIREMOCK_PORT)

                    startFlask()
                    startWiremock()

                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask')
                    waitHttp200("http://127.0.0.1:${env.WIREMOCK_PORT}/__admin", 10, 2, 'Healthcheck Wiremock')

                    int rc = bat(returnStatus: true, label: 'Pytest Rest', script: """
                        @echo off
                        set PYTHONPATH=.
                        "${PYTHON_BIN}" -m pytest --junitxml=${REST_JUNIT} test\\rest
                        exit /b %ERRORLEVEL%
                    """.stripIndent())
                    echo "Rest exit code: ${rc} (stage stays green by requirement)"
                }
            }
            post {
                always {
                    script {
                        killByPort(env.FLASK_PORT)
                        killByPort(env.WIREMOCK_PORT)
                    }
                    junit testResults: "${REST_JUNIT}", allowEmptyResults: true
                }
            }
        }

        stage('Static') {
            steps {
                script {
                    runFlake8()
                    int findings = countFlake8Findings().toInteger()
                    echo "Flake8 findings: ${findings}"

                    if (findings >= 10) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            error("Flake8 unhealthy: ${findings} >= 10")
                        }
                    } else if (findings >= 8) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            error("Flake8 unstable: ${findings} >= 8")
                        }
                    } else {
                        echo "Flake8 OK (<8)"
                    }
                }
            }
            post {
                always {
                    recordIssues(
                        tools: [flake8(pattern: "${FLAKE8_REPORT}")],
                        enabledForFailure: true
                    )
                }
            }
        }

        stage('Security Test (Bandit)') {
            steps {
                script {
                    runBandit()
                    int findings = countBanditFindings().toInteger()
                    echo "Bandit findings: ${findings}"

                    if (findings >= 4) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            error("Bandit unhealthy: ${findings} >= 4")
                        }
                    } else if (findings >= 2) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            error("Bandit unstable: ${findings} >= 2")
                        }
                    } else {
                        echo "Bandit OK (<2)"
                    }
                }
            }
            post {
                always {
                    script {
                        // Post must never abort the pipeline: capture any post parsing issues.
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            banditJsonToSarif()
                            recordIssues(
                                enabledForFailure: true,
                                tools: [sarif(pattern: "${BANDIT_SARIF}")]
                            )
                        }
                    }
                    archiveArtifacts artifacts: "${BANDIT_JSON},${BANDIT_REPORT},${BANDIT_SARIF}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        stage('Performance') {
            steps {
                script {
                    killByPort(env.FLASK_PORT)
                    startFlask()
                    waitHttp200("http://127.0.0.1:${env.FLASK_PORT}/", 10, 2, 'Healthcheck Flask (Perf)')

                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                        runJmeter()
                    }
                }
            }
            post {
                always {
                    script { killByPort(env.FLASK_PORT) }
                    perfReport(
                        sourceDataFiles: "${JMETER_JTL}",
                        errorFailedThreshold: 0,
                        errorUnstableThreshold: 0
                    )
                    archiveArtifacts artifacts: "${JMETER_JTL}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        stage('Coverage') {
            steps {
                script {
                    def (double linesPct, double branchesPct) = readCoveragePercents()
                    echo "Coverage lines: ${linesPct}%"
                    echo "Coverage branches: ${branchesPct}%"

                    boolean linesUnstable = (linesPct >= 85.0 && linesPct <= 95.0)
                    boolean linesFail = (linesPct < 85.0)

                    boolean branchesUnstable = (branchesPct >= 80.0 && branchesPct <= 90.0)
                    boolean branchesFail = (branchesPct < 80.0)

                    if (linesFail || branchesFail) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            error("Coverage unhealthy (lines=${linesPct}%, branches=${branchesPct}%)")
                        }
                    } else if (linesUnstable || branchesUnstable) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            error("Coverage unstable (lines=${linesPct}%, branches=${branchesPct}%)")
                        }
                    } else {
                        echo "Coverage OK"
                    }
                }
            }
            post {
                always {
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: "${COVERAGE_XML}"]],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                    archiveArtifacts artifacts: "${COVERAGE_XML},${COVERAGE_JSON}", fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }
}
